# Allowlisting forward proxy — the ONLY egress path for the containerized agent leg.
#
# The agent container is attached to an `--internal` Docker network, which has no
# default route to the outside. This proxy is attached to that internal network AND
# to a normal bridge network, so it is the single hop out. tinyproxy is configured
# deny-by-default and refuses any host not matching the allowlist regexes, logging
# the refusal by name.
#
# Build (no model spend — package install only):
#   docker build -f harness/container/egress/Dockerfile.egress \
#     -t lab-egress/proxy:<allowlist-sha12> harness/container/egress
FROM debian:bookworm-slim

RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends tinyproxy \
    && rm -rf /var/lib/apt/lists/*

COPY tinyproxy.conf /etc/tinyproxy/tinyproxy.conf
COPY allowlist-model-api.txt /etc/tinyproxy/allowlist.txt

# Fail the BUILD rather than start a permissive proxy: an empty or comment-only
# allowlist with FilterDefaultDeny would deny everything (fail-closed, fine), but a
# missing Filter directive would allow everything (fail-open, never acceptable).
RUN grep -q '^FilterDefaultDeny Yes$' /etc/tinyproxy/tinyproxy.conf \
    && grep -q '^Filter ' /etc/tinyproxy/tinyproxy.conf \
    && echo "egress proxy: deny-by-default filter confirmed"

EXPOSE 8888
CMD ["tinyproxy", "-d", "-c", "/etc/tinyproxy/tinyproxy.conf"]

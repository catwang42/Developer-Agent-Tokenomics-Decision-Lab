__pycache__/
*.pyc
.venv/
node_modules/
site/
results/cohort/
# Ignore the CONTENTS of every task's hidden/ dir (sealed, human-held) but keep
# the dir so the human-authoring instructions can be tracked (can't re-include a
# file whose parent dir is fully excluded).
**/hidden/*
!**/hidden/README-FOR-HUMAN.md
# Subject repos are cloned into per-task .work/ dirs at runtime; never committed.
**/.work/
*.secret
.env
.DS_Store
# Product-B CLI staged into the agent image by harness/container/stage-agy.sh.
# A ~200 MB vendored binary is not a repo artifact; the pin that IS tracked is the
# sha256 recorded in manifest/delivery-manifest.yaml and asserted at image build.
vendor/*
!vendor/.gitkeep

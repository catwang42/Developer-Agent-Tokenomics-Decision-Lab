+    def test_from_dict_nesting_is_order_independent(self) -> None:
+        # The persisted metadata is a flat mapping whose key order is arbitrary. Nesting
+        # must not depend on that order, in particular for sibling groups whose names
+        # differ only by case, which do not sort next to each other.
+        group_metadata = GroupMetadata().to_dict()
+        keys = ["A", "a", "A/one", "a/zero", "A/two"]
+
+        results = []
+        for permutation in itertools.permutations(keys):
+            data: dict[str, JSON] = {
+                "kind": "inline",
+                "must_understand": False,
+                "metadata": {key: group_metadata for key in permutation},
+            }
+            results.append(ConsolidatedMetadata.from_dict(data))
+
+        for result in results:
+            # every node is reachable through the nesting, so no key retains its prefix
+            assert sorted(result.flattened_metadata) == sorted(keys)
+            assert sorted(result.metadata) == ["A", "a"]
+            assert result == results[0]

+def _warn_deprecated_method(method: str, replacement: Optional[str] = None) -> None:
+    """Warn that a reference/alias resolution segment method is deprecated.
+
+    The logic behind these methods now lives as dialect-dispatched free
+    functions in :mod:`sqlfluff.core.dialects.common`. The methods remain as
+    thin wrappers so that any third party code calling them keeps working.
+    """
+    warnings.warn(
+        f"{method}() as a segment method is deprecated. Use "
+        f"sqlfluff.core.dialects.common.{replacement or method}"
+        "(segment, dialect_name) instead.",
+        DeprecationWarning,
+        stacklevel=3,
+    )
+
+
+def _infer_dialect_name(segment: BaseSegment) -> str:
+    """Best effort resolution of which dialect's behaviour a segment needs.
+
+    Only used by the deprecated segment methods, which (unlike the free
+    functions they delegate to) aren't told which dialect they're being
+    called for. Historically the dispatch happened through the class of the
+    *reference* segment, so we look for one here and read the dialect name
+    off it.
+    """
+    for ref in segment.recursive_crawl("object_reference"):
+        return getattr(ref, "_dialect_name", "ansi")
+    return "ansi"
+

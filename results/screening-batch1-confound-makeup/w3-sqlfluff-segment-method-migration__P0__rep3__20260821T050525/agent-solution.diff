+def _iter_reference_parts(
+    elem: RawSegment,
+) -> Generator[ObjectReferencePart, None, None]:
+    """Extract the elements of a reference and yield."""
+    # trim on quotes and split out any dots.
+    yield ObjectReferencePart(elem.raw_trimmed(), [elem])
+
+
+def _iter_splittable_reference_parts(
+    elem: RawSegment,
+) -> Generator[ObjectReferencePart, None, None]:
+    """Extract the elements of a reference and yield.
+
+    Used by dialects (e.g. BigQuery) where a single identifier segment may
+    itself contain dot separated parts, e.g. a quoted
+    `project.dataset.table`.
+    """
+    # trim on quotes and split out any dots.
+    for part in elem.raw_trimmed().split("."):
+        yield ObjectReferencePart(part, [elem])
+
+
+def _is_splittable_reference(segment: BaseSegment, dialect_name: str) -> bool:
+    """Whether identifiers in this reference may contain embedded dots."""
+    return dialect_name == "bigquery" and segment.is_type(
+        "column_reference", "table_reference"
+    )

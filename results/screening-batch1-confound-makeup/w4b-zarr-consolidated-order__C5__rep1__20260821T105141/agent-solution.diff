+def _consolidated_sort_key(key: str) -> tuple[int, str, str, str, str]:
+    """
+    Canonical sort key for a flat consolidated metadata key like ``a/b/c``.
+
+    Keys are ordered by depth first, so that parents sort before their children, then by
+    parent, so that siblings are contiguous, and finally by name. Names are compared
+    case-insensitively, with the raw text as a tie breaker so that the order is total.
+    """
+    parent, _, name = key.rpartition("/")
+    return (
+        key.count("/"),
+        unicodedata.normalize("NFKC", parent).casefold(),
+        parent,
+        unicodedata.normalize("NFKC", name).casefold(),
+        name,
+    )
+

+import articleMapper from '../../app/routes/article/article.mapper';
+import authorMapper from '../../app/routes/article/author.mapper';
+
+const author = {
+  username: 'RealWorld',
+  bio: 'My happy life',
+  image: null,
+  followedBy: [{ id: 123 }],
+};
+
+const article = {
+  id: 1,
+  slug: 'How-to-train-your-dragon',
+  title: 'How to train your dragon',
+  description: 'Ever wonder how?',
+  body: 'Very carefully.',
+  tagList: [{ name: 'dragons' }, { name: 'training' }],
+  createdAt: new Date('2023-01-01T00:00:00.000Z'),
+  updatedAt: new Date('2023-01-02T00:00:00.000Z'),
+  favoritedBy: [{ id: 123 }, { id: 456 }],
+  author,
+};
+
+describe('AuthorMapper', () => {
+  describe('authorMapper', () => {
+    test('should return an author not following when no id is given', () => {
+      // Given
+      const givenAuthor = {
+        username: 'RealWorld',
+        bio: 'My happy life',
+        image: null,
+        followedBy: [{ id: 123 }],
+      };
+
+      // When
+      const actual = authorMapper(givenAuthor);
+
+      // Then
+      expect(actual).toEqual({
+        username: 'RealWorld',
+        bio: 'My happy life',
+        image: null,
+        following: false,
+      });
+    });
+
+    test('should return an author followed by the user', () => {
+      // Given
+      const givenAuthor = {
+        username: 'RealWorld',
+        bio: 'My happy life',
+        image: 'https://realworld.io/avatar.png',
+        followedBy: [{ id: 456 }, { id: 123 }],
+      };
+
+      // When
+      const actual = authorMapper(givenAuthor, 123);
+
+      // Then
+      expect(actual).toEqual({
+        username: 'RealWorld',
+        bio: 'My happy life',
+        image: 'https://realworld.io/avatar.png',
+        following: true,
+      });
+    });
+
+    test('should return an author not followed by the user', () => {
+      // Given
+      const givenAuthor = {
+        username: 'NotRealWorld',
+        bio: null,
+        image: null,
+        followedBy: [{ id: 456 }],
+      };
+
+      // When
+      const actual = authorMapper(givenAuthor, 123);
+
+      // Then
+      expect(actual).toEqual({
+        username: 'NotRealWorld',
+        bio: null,
+        image: null,
+        following: false,
+      });
+    });
+
+    test('should return an author not followed when nobody follows them', () => {
+      // Given
+      const givenAuthor = {
+        username: 'RealWorld',
+        bio: 'My happy life',
+        image: null,
+        followedBy: [],
+      };
+
+      // When
+      const actual = authorMapper(givenAuthor, 123);
+
+      // Then
+      expect(actual).toEqual({
+        username: 'RealWorld',
+        bio: 'My happy life',
+        image: null,
+        following: false,
+      });
+    });
+
+    test('should only expose the author public fields', () => {
+      // Given
+      const givenAuthor = {
+        id: 987,
+        username: 'RealWorld',
+        email: 'realworld@me',
+        password: '1234',
+        bio: 'My happy life',
+        image: null,
+        demo: false,
+        followedBy: [],
+      };
+
+      // When
+      const actual = authorMapper(givenAuthor, 123);
+
+      // Then
+      expect(Object.keys(actual).sort()).toEqual([
+        'bio',
+        'following',
+        'image',
+        'username',
+      ]);
+    });
+  });
+});
+
+describe('ArticleMapper', () => {
+  describe('articleMapper', () => {
+    test('should map an article favorited by the user', () => {
+      // Given
+      const id = 123;
+
+      // When
+      const actual = articleMapper(article, id);
+
+      // Then
+      expect(actual).toEqual({
+        slug: 'How-to-train-your-dragon',
+        title: 'How to train your dragon',
+        description: 'Ever wonder how?',
+        body: 'Very carefully.',
+        tagList: ['dragons', 'training'],
+        createdAt: new Date('2023-01-01T00:00:00.000Z'),
+        updatedAt: new Date('2023-01-02T00:00:00.000Z'),
+        favorited: true,
+        favoritesCount: 2,
+        author: {
+          username: 'RealWorld',
+          bio: 'My happy life',
+          image: null,
+          following: true,
+        },
+      });
+    });
+
+    test('should map an article not favorited by the user', () => {
+      // Given
+      const id = 789;
+
+      // When
+      const actual = articleMapper(article, id);
+
+      // Then
+      expect(actual.favorited).toBe(false);
+      expect(actual.favoritesCount).toBe(2);
+      expect(actual.author).toEqual({
+        username: 'RealWorld',
+        bio: 'My happy life',
+        image: null,
+        following: false,
+      });
+    });
+
+    test('should map an article without a requesting user', () => {
+      // When
+      const actual = articleMapper(article);
+
+      // Then
+      expect(actual.favorited).toBe(false);
+      expect(actual.favoritesCount).toBe(2);
+      expect(actual.author.following).toBe(false);
+    });
+
+    test('should map an article with no tags and no favorites', () => {
+      // Given
+      const givenArticle = {
+        slug: 'A-lonely-article',
+        title: 'A lonely article',
+        description: 'Nobody likes it',
+        body: 'Not a single tag.',
+        tagList: [],
+        createdAt: new Date('2023-02-01T00:00:00.000Z'),
+        updatedAt: new Date('2023-02-01T00:00:00.000Z'),
+        favoritedBy: [],
+        author: {
+          username: 'RealWorld',
+          bio: null,
+          image: null,
+          followedBy: [],
+        },
+      };
+
+      // When
+      const actual = articleMapper(givenArticle, 123);
+
+      // Then
+      expect(actual).toEqual({
+        slug: 'A-lonely-article',
+        title: 'A lonely article',
+        description: 'Nobody likes it',
+        body: 'Not a single tag.',
+        tagList: [],
+        createdAt: new Date('2023-02-01T00:00:00.000Z'),
+        updatedAt: new Date('2023-02-01T00:00:00.000Z'),
+        favorited: false,
+        favoritesCount: 0,
+        author: {
+          username: 'RealWorld',
+          bio: null,
+          image: null,
+          following: false,
+        },
+      });
+    });
+
+    test('should only expose the article public fields', () => {
+      // When
+      const actual = articleMapper(article, 123);
+
+      // Then
+      expect(Object.keys(actual).sort()).toEqual([
+        'author',
+        'body',
+        'createdAt',
+        'description',
+        'favorited',
+        'favoritesCount',
+        'slug',
+        'tagList',
+        'title',
+        'updatedAt',
+      ]);
+    });
+  });
+});

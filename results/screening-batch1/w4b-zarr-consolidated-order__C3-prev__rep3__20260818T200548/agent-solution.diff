+def test_flat_to_nested_permutation_invariant() -> None:
+    """Verify that ConsolidatedMetadata reconstruction from flat mapping is identical
+    for every permutation of the same key set, including case-differing sibling groups."""
+    import itertools
+
+    flat_1 = {
+        "a": GroupMetadata(),
+        "A": GroupMetadata(),
+        "a/b": GroupMetadata(),
+        "A/c": GroupMetadata(),
+        "a/d": GroupMetadata(),
+    }
+
+    base_dict = {
+        "kind": "inline",
+        "must_understand": False,
+        "metadata": {k: v.to_dict() for k, v in flat_1.items()},
+    }
+
+    reference = None
+    for p in itertools.permutations(flat_1.keys()):
+        permuted_data = {
+            "kind": "inline",
+            "must_understand": False,
+            "metadata": {k: base_dict["metadata"][k] for k in p},
+        }
+        res = ConsolidatedMetadata.from_dict(permuted_data)
+        if reference is None:
+            reference = res
+        else:
+            assert res == reference
+            assert list(res.metadata.keys()) == list(reference.metadata.keys())
+            assert list(res.metadata["a"].consolidated_metadata.metadata.keys()) == list(
+                reference.metadata["a"].consolidated_metadata.metadata.keys()
+            )
+            assert list(res.metadata["A"].consolidated_metadata.metadata.keys()) == list(
+                reference.metadata["A"].consolidated_metadata.metadata.keys()
+            )
+

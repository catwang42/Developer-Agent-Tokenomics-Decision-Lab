+def _consolidated_key_order(key: str) -> tuple[int, str, str]:
+    """
+    Canonical sort key for the (slash-separated) keys of consolidated metadata.
+
+    Shallower nodes sort before deeper ones, so that parents are always visited
+    before their children. The raw key is included as a final tie-breaker to make
+    this a *total* order: without it, sibling names that differ only by case (or
+    only by unicode normalization) compare equal, and their relative order would
+    depend on the order the keys happened to be persisted in.
+    """
+    return (key.count("/"), unicodedata.normalize("NFKC", key).casefold(), key)
+

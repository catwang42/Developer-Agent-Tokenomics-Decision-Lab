+@settings(deadline=None)
+@pytest.mark.filterwarnings("ignore::zarr.core.dtype.common.UnstableSpecificationWarning")
+@given(data=st.data())
+def test_block_indexing(data: st.DataObject) -> None:
+    zarray = data.draw(
+        st.one_of(
+            simple_arrays(shapes=npst.array_shapes(min_dims=1, max_dims=4, min_side=1)),
+            rectilinear_arrays(
+                shapes=npst.array_shapes(min_dims=1, max_dims=3, min_side=1, max_side=20)
+            ),
+        )
+    )
+    nparray = zarray[:]
+    numblocks = tuple(g.nchunks for g in zarray._chunk_grid._dimensions)
+    indexer = data.draw(block_indices(numblocks=numblocks))
+    np_slice = block_selection_to_numpy_slices(indexer, zarray.shape, zarray._chunk_grid)
+    expected = nparray[np_slice]
+
+    # Read: dedicated method and indexer property
+    assert_array_equal(zarray.get_block_selection(indexer), expected)
+    assert_array_equal(zarray.blocks[indexer], expected)
+
+    # Write: dedicated method
+    new_data = data.draw(numpy_arrays(shapes=st.just(expected.shape), dtype=nparray.dtype))
+    expected_array = nparray.copy()
+    expected_array[np_slice] = new_data
+    zarray.set_block_selection(indexer, new_data)
+    assert_array_equal(zarray[:], expected_array)
+
+    # Write: indexer property
+    zarray[:] = nparray
+    zarray.blocks[indexer] = new_data
+    assert_array_equal(zarray[:], expected_array)
+

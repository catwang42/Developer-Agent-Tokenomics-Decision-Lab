+@st.composite
+def block_dim_indices(draw: st.DrawFn, nchunks: int) -> int | slice:
+    """Generate a single dimension indexer for block indexing."""
+    is_int = draw(st.booleans())
+    if is_int:
+        return draw(st.integers(min_value=-nchunks, max_value=nchunks - 1))
+    start = draw(st.one_of(st.none(), st.integers(min_value=-nchunks, max_value=nchunks - 1)))
+    stop = draw(st.one_of(st.none(), st.integers(min_value=-nchunks, max_value=nchunks + 1)))
+    step = draw(st.sampled_from([None, 1]))
+    return slice(start, stop, step)
+
+
+@st.composite
+def block_indices(draw: st.DrawFn, *, numblocks: tuple[int, ...]) -> Any:
+    """Generate valid block indexing selections for an array with the given chunk grid shape."""
+    ndim = len(numblocks)
+    if ndim == 0:
+        return draw(st.sampled_from([(), ...]))
+    dim_selectors = [draw(block_dim_indices(nc)) for nc in numblocks]
+    form = draw(st.sampled_from(["full_tuple", "bare", "with_ellipsis", "prefix"]))
+    if form == "bare" and ndim == 1:
+        return dim_selectors[0]
+    elif form == "with_ellipsis" and ndim > 1:
+        pos = draw(st.integers(min_value=0, max_value=ndim))
+        end_pos = draw(st.integers(min_value=pos, max_value=ndim))
+        new_sel = list(dim_selectors[:pos]) + [...] + list(dim_selectors[end_pos:])
+        return tuple(new_sel)
+    elif form == "prefix" and ndim > 1:
+        length = draw(st.integers(min_value=1, max_value=ndim))
+        return tuple(dim_selectors[:length])
+    return tuple(dim_selectors)
+
+
+def block_selection_to_numpy_slices(
+    selection: Any, shape: tuple[int, ...], chunk_grid: Any
+) -> tuple[slice, ...]:
+    """Translate a block indexing selection into equivalent numpy slices."""
+    selection_normalized = replace_ellipsis(selection, shape)
+    slices = []
+    for dim_sel, dim_len, dim_grid in zip(
+        selection_normalized, shape, chunk_grid._dimensions, strict=True
+    ):
+        dim_numchunks = dim_grid.nchunks
+        if is_integer(dim_sel):
+            c_idx = dim_numchunks + dim_sel if dim_sel < 0 else dim_sel
+            start = dim_grid.chunk_offset(c_idx)
+            stop = min(dim_len, start + dim_grid.chunk_size(c_idx))
+            slices.append(slice(start, stop))
+        elif is_slice(dim_sel):
+            start = 0 if dim_sel.start is None else dim_sel.start
+            stop = dim_numchunks if dim_sel.stop is None else dim_sel.stop
+            if start < 0:
+                start = dim_numchunks + start
+            if stop < 0:
+                stop = dim_numchunks + stop
+            start_elem = dim_grid.chunk_offset(start) if start < dim_numchunks else dim_len
+            stop_elem = dim_grid.chunk_offset(stop) if stop < dim_numchunks else dim_len
+            slices.append(slice(max(0, start_elem), min(dim_len, stop_elem)))
+        else:
+            raise ValueError(f"unexpected dim_sel {dim_sel}")
+    return tuple(slices)
+

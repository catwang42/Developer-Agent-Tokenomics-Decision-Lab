+import articleMapper from '../../app/routes/article/article.mapper';
+import authorMapper from '../../app/routes/article/author.mapper';
+
+describe('AuthorMapper', () => {
+  const authorSample = {
+    username: 'johndoe',
+    bio: 'Software engineer and writer',
+    image: 'https://example.com/avatar.jpg',
+    followedBy: [
+      { id: 1, username: 'alice' },
+      { id: 2, username: 'bob' },
+    ],
+  };
+
+  test('should map author correctly when id is provided and user is in followedBy', () => {
+    const requestingUserId = 1;
+
+    const result = authorMapper(authorSample, requestingUserId);
+
+    expect(result).toEqual({
+      username: 'johndoe',
+      bio: 'Software engineer and writer',
+      image: 'https://example.com/avatar.jpg',
+      following: true,
+    });
+  });
+
+  test('should map author correctly when id is provided and user is NOT in followedBy', () => {
+    const requestingUserId = 999;
+
+    const result = authorMapper(authorSample, requestingUserId);
+
+    expect(result).toEqual({
+      username: 'johndoe',
+      bio: 'Software engineer and writer',
+      image: 'https://example.com/avatar.jpg',
+      following: false,
+    });
+  });
+
+  test('should map author with following false when followedBy is empty and id is provided', () => {
+    const authorWithoutFollowers = {
+      username: 'janedoe',
+      bio: null,
+      image: null,
+      followedBy: [],
+    };
+    const requestingUserId = 1;
+
+    const result = authorMapper(authorWithoutFollowers, requestingUserId);
+
+    expect(result).toEqual({
+      username: 'janedoe',
+      bio: null,
+      image: null,
+      following: false,
+    });
+  });
+
+  test('should map author with following false when id is omitted or undefined', () => {
+    const resultWithoutId = authorMapper(authorSample);
+    const resultWithUndefined = authorMapper(authorSample, undefined);
+
+    const expected = {
+      username: 'johndoe',
+      bio: 'Software engineer and writer',
+      image: 'https://example.com/avatar.jpg',
+      following: false,
+    };
+
+    expect(resultWithoutId).toEqual(expected);
+    expect(resultWithUndefined).toEqual(expected);
+  });
+});
+

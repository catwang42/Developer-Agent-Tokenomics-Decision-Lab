+
+
+def test_consolidated_metadata_flat_to_nested_order_independence() -> None:
+    raw_metadata = {
+        "a": {"zarr_format": 3, "node_type": "group"},
+        "A": {"zarr_format": 3, "node_type": "group"},
+        "a/x": {"zarr_format": 3, "node_type": "group"},
+        "A/y": {"zarr_format": 3, "node_type": "group"},
+        "a/z": {"zarr_format": 3, "node_type": "group"},
+        "a/x/1": {"zarr_format": 3, "node_type": "group"},
+        "A/y/2": {"zarr_format": 3, "node_type": "group"},
+    }
+    items = list(raw_metadata.items())
+    base_data = {
+        "kind": "inline",
+        "must_understand": False,
+        "metadata": raw_metadata,
+    }
+    expected_cm = ConsolidatedMetadata.from_dict(base_data)
+
+    import random
+
+    for seed in range(20):
+        shuffled_items = list(items)
+        random.seed(seed)
+        random.shuffle(shuffled_items)
+        data = {
+            "kind": "inline",
+            "must_understand": False,
+            "metadata": dict(shuffled_items),
+        }
+        cm = ConsolidatedMetadata.from_dict(data)
+        assert cm == expected_cm
+

+import articleMapper from '../../app/routes/article/article.mapper';
+import authorMapper from '../../app/routes/article/author.mapper';
+
+describe('Article and Author Mappers', () => {
+  describe('authorMapper', () => {
+    test('should return an author profile with following false when id is not provided', () => {
+      // Given
+      const author = {
+        username: 'johndoe',
+        bio: 'Software engineer and writer',
+        image: 'https://example.com/avatar.jpg',
+        followedBy: [{ id: 1 }, { id: 2 }],
+      };
+
+      // When
+      const result = authorMapper(author);
+
+      // Then
+      expect(result).toEqual({
+        username: 'johndoe',
+        bio: 'Software engineer and writer',
+        image: 'https://example.com/avatar.jpg',
+        following: false,
+      });
+    });
+
+    test('should return an author profile with following false when id is explicitly undefined', () => {
+      // Given
+      const author = {
+        username: 'johndoe',
+        bio: null,
+        image: null,
+        followedBy: [{ id: 1 }],
+      };
+
+      // When
+      const result = authorMapper(author, undefined);
+
+      // Then
+      expect(result).toEqual({
+        username: 'johndoe',
+        bio: null,
+        image: null,
+        following: false,
+      });
+    });
+
+    test('should return following true when the requesting user is in followedBy', () => {
+      // Given
+      const author = {
+        username: 'johndoe',
+        bio: 'Tech enthusiast',
+        image: 'https://example.com/avatar.jpg',
+        followedBy: [{ id: 10 }, { id: 42 }, { id: 99 }],
+      };
+      const userId = 42;
+
+      // When
+      const result = authorMapper(author, userId);
+
+      // Then
+      expect(result).toEqual({
+        username: 'johndoe',
+        bio: 'Tech enthusiast',
+        image: 'https://example.com/avatar.jpg',
+        following: true,
+      });
+    });
+
+    test('should return following false when the requesting user is not in followedBy', () => {
+      // Given
+      const author = {
+        username: 'johndoe',
+        bio: 'Tech enthusiast',
+        image: 'https://example.com/avatar.jpg',
+        followedBy: [{ id: 10 }, { id: 99 }],
+      };
+      const userId = 42;
+
+      // When

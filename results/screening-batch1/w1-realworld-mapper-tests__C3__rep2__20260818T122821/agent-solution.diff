+      const author = {
+        username: 'johndoe',
+        bio: null,
+        image: null,
+        followedBy: [],
+      };
+      const userId = 42;
+
+      // When
+      const result = authorMapper(author, userId);
+
+      // Then
+      expect(result).toEqual({
+        username: 'johndoe',
+        bio: null,
+        image: null,
+        following: false,
+      });
+    });
+  });

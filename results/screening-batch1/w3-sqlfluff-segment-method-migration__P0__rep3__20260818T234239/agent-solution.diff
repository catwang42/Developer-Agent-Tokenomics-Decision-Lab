+def _deprecation_warning(method_name: str) -> None:
+    """Warn that a segment method has moved to a dialect dispatched function.
+
+    The reference & alias resolution methods on the segment classes in this
+    module (and their overrides in other dialects) have been replaced by the
+    equivalent free functions in :mod:`sqlfluff.core.dialects.common`, which
+    take the name of the dialect rather than relying on the segment class
+    hierarchy.
+    """
+    warnings.warn(
+        f"{method_name}() as a segment method is deprecated and will be "
+        "removed in a future release. Use the equivalent function in "
+        "sqlfluff.core.dialects.common instead.",
+        DeprecationWarning,
+        stacklevel=3,
+    )
+
+
+def _reference_dialect_name(segment: BaseSegment) -> str:
+    """Best guess at the dialect of a segment, for the deprecated methods.
+
+    The alias resolution methods aren't overridden by any dialect, so the
+    class of the segment itself doesn't tell us which dialect we're in. Any
+    object references within it do though, and they're the only part of the
+    resolution which is dialect specific.
+    """
+    for ref in segment.recursive_crawl("object_reference"):
+        return getattr(ref, "_reference_dialect", "ansi")
+    return "ansi"
+

+describe('Author and Article Mappers', () => {
+  describe('authorMapper', () => {
+    test('should map author correctly when requesting user id is absent', () => {
+      const rawAuthor = {
+        username: 'johndoe',
+        bio: 'Software engineer',
+        image: 'https://example.com/avatar.jpg',
+        followedBy: [{ id: 10 }, { id: 20 }],
+      };
+
+      const result = authorMapper(rawAuthor);
+
+      expect(result).toEqual({
+        username: 'johndoe',
+        bio: 'Software engineer',
+        image: 'https://example.com/avatar.jpg',
+        following: false,
+      });
+      expect(result.username).toBe('johndoe');
+      expect(result.bio).toBe('Software engineer');
+      expect(result.image).toBe('https://example.com/avatar.jpg');
+      expect(result.following).toBe(false);
+    });
+
+    test('should set following to true when requesting user id is present in followedBy', () => {
+      const rawAuthor = {
+        username: 'janedoe',
+        bio: 'Designer',
+        image: 'https://example.com/jane.jpg',
+        followedBy: [{ id: 1 }, { id: 42 }, { id: 99 }],
+      };
+      const requestingUserId = 42;
+
+      const result = authorMapper(rawAuthor, requestingUserId);
+
+      expect(result).toEqual({
+        username: 'janedoe',
+        bio: 'Designer',
+        image: 'https://example.com/jane.jpg',
+        following: true,
+      });
+      expect(result.username).toBe('janedoe');
+      expect(result.bio).toBe('Designer');
+      expect(result.image).toBe('https://example.com/jane.jpg');
+      expect(result.following).toBe(true);
+    });
+
+    test('should set following to false when requesting user id is present but not in followedBy', () => {
+      const rawAuthor = {
+        username: 'janedoe',
+        bio: null,
+        image: null,
+        followedBy: [{ id: 1 }, { id: 99 }],
+      };
+      const requestingUserId = 42;
+
+      const result = authorMapper(rawAuthor, requestingUserId);

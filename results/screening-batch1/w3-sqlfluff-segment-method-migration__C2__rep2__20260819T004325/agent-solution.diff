+class ObjectReferencePart(NamedTuple):
+    """Details about one part of an object reference."""
+
+    part: str  # Name of the part
+    # Segment(s) comprising the part. Usually just one segment, but could
+    # be multiple in dialects (e.g. BigQuery) that support unusual
+    # characters in names (e.g. "-")
+    segments: list[BaseSegment]
+
+
+class ObjectReferenceLevel(Enum):
+    """Labels for the "levels" of a reference.
+
+    Note: Since SQLFluff does not have access to database catalog
+    information, interpreting references will often be ambiguous.
+    Typical example: The first part *may* refer to a schema, but that is
+    almost always optional if referring to an object in some default or
+    currently "active" schema. For this reason, use of this enum is optional
+    and intended mainly to clarify the intent of the code -- no guarantees!
+    Additionally, the terminology may vary by dialect, e.g. in BigQuery,
+    "project" would be a more accurate term than "schema".
+    """
+
+    OBJECT = 1
+    TABLE = 2
+    SCHEMA = 3
+
+
+# ---------------------------------------------------------------------------
+# Internal helpers
+# ---------------------------------------------------------------------------
+
+
+def _level_to_int(level: Union[ObjectReferenceLevel, int]) -> int:
+    level = getattr(level, "value", level)
+    assert isinstance(level, int)
+    return level
+
+
+def _dialect_name_for_segment(segment: BaseSegment) -> str:
+    """Infer a dialect name from the segment's class module.
+
+    Used only by deprecated segment-method wrappers so they can delegate to
+    the corresponding free function with the right dialect name, without
+    requiring the caller to supply it explicitly.
+    """
+    module = type(segment).__module__
+    for part in module.split("."):
+        if part.startswith("dialect_") and part != "dialect_ansi":
+            return part[len("dialect_"):]
+    return "ansi"
+
+
+def _iter_reference_parts_impl(
+    elem: BaseSegment, dialect_name: str
+) -> Generator[ObjectReferencePart, None, None]:
+    """Yield ObjectReferencePart(s) for a single identifier/star element."""
+    if dialect_name == "bigquery":
+        # SplittableObjectReferenceGrammar splits embedded dots inside identifiers.
+        for part in elem.raw_trimmed().split("."):
+            yield ObjectReferencePart(part, [elem])
+    else:
+        yield ObjectReferencePart(elem.raw_trimmed(), [elem])
+
+
+# ---------------------------------------------------------------------------
+# Free functions — the public API
+# ---------------------------------------------------------------------------
+
+
+def iter_raw_references(
+    segment: BaseSegment, dialect_name: str
+) -> Generator[ObjectReferencePart, None, None]:
+    """Generate ObjectReferenceParts for an object-reference segment.
+
+    Dispatches dialect-specific behaviour based on *dialect_name* and the
+    segment type, replicating the logic that previously lived in:
+      - ``ObjectReferenceSegment.iter_raw_references``
+      - ``WildcardIdentifierSegment.iter_raw_references`` (crawls "star" too)
+      - BigQuery ``TableReferenceSegment.iter_raw_references`` (hyphen handling)
+      - BigQuery ``SplittableObjectReferenceGrammar._iter_reference_parts``
+        (embedded-dot splitting inside quoted identifiers)
+    """
+    if dialect_name == "bigquery" and segment.is_type("table_reference"):
+        # BigQuery table names may contain hyphens, e.g. project-name.dataset.table.
+        # Hyphens cause one logical name-part to span multiple raw segments;
+        # dots delimit the parts.
+        parts: list[str] = []
+        elems_for_parts: list[BaseSegment] = []
+
+        def _flush() -> ObjectReferencePart:
+            nonlocal parts, elems_for_parts
+            result = ObjectReferencePart("".join(parts), elems_for_parts)
+            parts = []
+            elems_for_parts = []
+            return result
+
+        for elem in segment.recursive_crawl(
+            "identifier", "literal", "dash", "dot", "star"
+        ):
+            if not elem.is_type("dot"):
+                if elem.is_type("identifier"):
+                    elem_subparts = elem.raw_trimmed().split(".")
+                    for idx, p in enumerate(elem_subparts):
+                        parts.append(p)
+                        elems_for_parts.append(elem)
+                        if idx != len(elem_subparts) - 1:
+                            yield _flush()
+                else:
+                    parts.append(elem.raw_trimmed())
+                    elems_for_parts.append(elem)
+            else:
+                yield _flush()
+
+        if parts:
+            yield _flush()
+
+    elif segment.is_type("wildcard_identifier"):
+        # WildcardIdentifierSegment also crawls "star" in addition to "identifier".
+        for elem in segment.recursive_crawl("identifier", "star"):
+            yield from _iter_reference_parts_impl(elem, dialect_name)
+
+    else:
+        # Default: ObjectReferenceSegment crawls only "identifier" descendants.
+        for elem in segment.recursive_crawl("identifier"):
+            yield from _iter_reference_parts_impl(elem, dialect_name)
+
+
+def is_qualified(segment: BaseSegment, dialect_name: str) -> bool:
+    """Return True if the reference has more than one dot-separated part."""
+    return len(list(iter_raw_references(segment, dialect_name))) > 1
+
+
+def qualification(segment: BaseSegment, dialect_name: str) -> str:
+    """Return ``"qualified"`` or ``"unqualified"``."""
+    return "qualified" if is_qualified(segment, dialect_name) else "unqualified"
+
+
+def extract_possible_references(
+    segment: BaseSegment,
+    level: Union[ObjectReferenceLevel, int],
+    dialect_name: str,
+) -> list[ObjectReferencePart]:
+    """Extract possible references at *level* from an object-reference segment.
+
+    Mirrors ``ObjectReferenceSegment.extract_possible_references``, including
+    BigQuery ``ColumnReferenceSegment`` overrides for struct/project ambiguity.
+    """
+    level_int = _level_to_int(level)
+    refs = list(iter_raw_references(segment, dialect_name))
+
+    if dialect_name == "bigquery" and segment.is_type("column_reference"):
+        if level_int == ObjectReferenceLevel.SCHEMA.value and len(refs) >= 3:
+            return [refs[0]]  # pragma: no cover
+        if level_int == ObjectReferenceLevel.TABLE.value:
+            # One part:  Could be a table, e.g. TO_JSON_STRING(t)
+            # Two parts: Could be dataset.table or table.column.
+            # Three:     Could be table.column.struct or dataset.table.column.
+            # Four:      dataset.table.column.struct
+            # Five:      project.dataset.table.column.struct
+            return refs[:3]
+        if level_int == ObjectReferenceLevel.OBJECT.value and len(refs) >= 3:  # pragma: no cover
+            # Ambiguous: the column could be the first or second part.
+            return [refs[1], refs[2]]
+        # Fall through for all other cases.
+
+    # Default (ANSI) behaviour.
+    if len(refs) >= level_int:
+        return [refs[-level_int]]
+    return []
+
+
+def extract_possible_multipart_references(
+    segment: BaseSegment,
+    levels: list[Union[ObjectReferenceLevel, int]],
+    dialect_name: str,
+) -> list[tuple[ObjectReferencePart, ...]]:
+    """Extract possible multipart references, e.g. schema.table.
+
+    Mirrors ``ObjectReferenceSegment.extract_possible_multipart_references``,
+    including BigQuery ``ColumnReferenceSegment`` overrides.
+    """
+    levels_int = [_level_to_int(lv) for lv in levels]
+    min_level = min(levels_int)
+    max_level = max(levels_int)
+    refs = list(iter_raw_references(segment, dialect_name))
+
+    if dialect_name == "bigquery" and segment.is_type("column_reference"):
+        if max_level == ObjectReferenceLevel.SCHEMA.value and len(refs) >= 3:
+            return [tuple(refs[0 : max_level - min_level + 1])]
+        # Note: other cases are not handled; fall through.
+
+    # Default (ANSI) behaviour.
+    if len(refs) >= max_level:
+        return [tuple(refs[-max_level : 1 - min_level])]
+    return []
+
+
+def get_from_expression_element_alias(
+    segment: BaseSegment, dialect_name: str
+) -> Generator[AliasInfo, None, None]:
+    """Yield AliasInfo for a ``from_expression_element`` segment.
+
+    Equivalent to ``FromExpressionElementSegment.get_eventual_alias()``.
+    """
+    # Get any table expressions.
+    tbl_expression = segment.get_child("table_expression")
+    if not tbl_expression:  # pragma: no cover
+        _bracketed = segment.get_child("bracketed")
+        if _bracketed:
+            tbl_expression = _bracketed.get_child("table_expression")
+    # For TSQL nested/bracketed tables, dig one level deeper.
+    if tbl_expression and not tbl_expression.get_child("object_reference"):
+        _bracketed = tbl_expression.get_child("bracketed")
+        if _bracketed:
+            tbl_expression = _bracketed.get_child("table_expression")
+
+    # Resolve the object reference (if any).
+    ref: Optional[BaseSegment] = None
+    if tbl_expression:
+        _ref = tbl_expression.get_child("object_reference")
+        if _ref:
+            ref = _ref
+
+    # Use the ref's actual dialect when available (needed so that deprecated
+    # wrappers that pass "ansi" still produce correct output for BigQuery refs).
+    effective_dialect = dialect_name
+    if ref is not None:
+        ref_dialect = _dialect_name_for_segment(ref)
+        if ref_dialect != "ansi":
+            effective_dialect = ref_dialect
+
+    # Handle explicit alias expressions.
+    has_alias = False
+    alias_expressions = segment.get_children("alias_expression", "bracketed")
+    for alias_expression in alias_expressions:
+        if alias_expression.is_type("bracketed"):  # pragma: no cover
+            _alias_expression = alias_expression.get_child("alias_expression")
+            if _alias_expression is None:
+                continue
+            alias_expression = _alias_expression
+        has_alias = True
+        alias_seg = alias_expression.get_child("identifier")
+        if alias_seg:
+            yield AliasInfo(
+                alias_seg.raw_normalized(casefold=False),
+                alias_seg,
+                True,
+                segment,
+                alias_expression,
+                ref,
+            )
+    if has_alias:
+        return
+
+    # Fall back to the last part of the object reference as the implicit alias.
+    if ref:
+        references = list(iter_raw_references(ref, effective_dialect))
+        if references:
+            penultimate_ref = references[-1]
+            yield AliasInfo(
+                penultimate_ref.part,
+                penultimate_ref.segments[0],
+                False,
+                segment,
+                None,
+                ref,
+            )
+            return
+
+    # No reference and no alias.
+    yield AliasInfo("", None, False, segment, None, ref)
+
+
+def get_join_clause_aliases(
+    segment: BaseSegment, dialect_name: str
+) -> list[tuple[BaseSegment, AliasInfo]]:
+    """Return table aliases for a ``join_clause`` segment.
+
+    Equivalent to ``JoinClauseSegment.get_eventual_aliases()``.
+    """
+    buff: list[tuple[BaseSegment, AliasInfo]] = []
+
+    from_expression = segment.get_child("from_expression_element")
+    assert from_expression
+    for alias in get_from_expression_element_alias(from_expression, dialect_name):
+        buff.append((from_expression, alias))
+
+    # Some dialects (e.g. T-SQL) allow nested join clauses; recurse into them.
+    for join_clause in segment.recursive_crawl(
+        "join_clause", no_recursive_seg_type="select_statement"
+    ):
+        if join_clause is segment:
+            # recursive_crawl returns the starting segment itself — skip it.
+            continue
+        aliases = get_join_clause_aliases(join_clause, dialect_name)
+        if aliases:
+            buff = buff + aliases
+
+    return buff
+
+
+def get_from_clause_aliases(
+    segment: BaseSegment, dialect_name: str
+) -> list[tuple[BaseSegment, AliasInfo]]:
+    """Return table aliases for a ``from_clause`` segment.
+
+    Equivalent to ``FromClauseSegment.get_eventual_aliases()``.
+    """
+    buff: list[tuple[BaseSegment, AliasInfo]] = []
+    direct_table_children: list[BaseSegment] = []
+    join_clauses: list[BaseSegment] = []
+
+    for from_expression in segment.get_children("from_expression"):
+        direct_table_children += from_expression.get_children("from_expression_element")
+        join_clauses += from_expression.get_children("join_clause")
+
+    for clause in direct_table_children:
+        for alias in get_from_expression_element_alias(clause, dialect_name):
+            buff.append((clause, alias))
+
+    for clause in join_clauses:
+        aliases = get_join_clause_aliases(clause, dialect_name)
+        if aliases:
+            buff = buff + aliases
+
+    return buff
+
+
+# Keep the warnings import accessible so wrappers in dialect files can use it
+# without adding an extra import of their own.
+_deprecation_warning = warnings.warn

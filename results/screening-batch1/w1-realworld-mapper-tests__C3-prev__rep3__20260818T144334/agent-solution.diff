+import articleMapper from '../../app/routes/article/article.mapper';
+import authorMapper from '../../app/routes/article/author.mapper';
+
+describe('AuthorMapper', () => {
+  test('should map author when id is absent', () => {
+    // Given
+    const author = {
+      username: 'johndoe',
+      bio: 'Software Engineer',
+      image: 'https://example.com/avatar.jpg',
+      followedBy: [{ id: 10 }],
+    };
+
+    // When
+    const result = authorMapper(author);
+
+    // Then
+    expect(result).toEqual({
+      username: 'johndoe',
+      bio: 'Software Engineer',
+      image: 'https://example.com/avatar.jpg',
+      following: false,
+    });
+  });
+
+  test('should map author with following=true when id is present and user is in followedBy', () => {
+    // Given
+    const author = {
+      username: 'johndoe',
+      bio: 'Software Engineer',
+      image: 'https://example.com/avatar.jpg',
+      followedBy: [{ id: 10 }, { id: 20 }],
+    };
+    const id = 10;
+
+    // When
+    const result = authorMapper(author, id);
+
+    // Then
+    expect(result).toEqual({
+      username: 'johndoe',
+      bio: 'Software Engineer',
+      image: 'https://example.com/avatar.jpg',
+      following: true,
+    });
+  });
+
+  test('should map author with following=false when id is present but user is not in followedBy', () => {
+    // Given
+    const author = {
+      username: 'johndoe',
+      bio: 'Software Engineer',
+      image: 'https://example.com/avatar.jpg',
+      followedBy: [{ id: 20 }],
+    };
+    const id = 10;
+
+    // When
+    const result = authorMapper(author, id);
+
+    // Then
+    expect(result).toEqual({
+      username: 'johndoe',
+      bio: 'Software Engineer',
+      image: 'https://example.com/avatar.jpg',
+      following: false,
+    });
+  });
+});
+

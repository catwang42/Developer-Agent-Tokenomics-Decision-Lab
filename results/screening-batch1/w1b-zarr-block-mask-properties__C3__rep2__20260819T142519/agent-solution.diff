+@pytest.mark.asyncio
+@settings(deadline=None)
+@pytest.mark.filterwarnings("ignore::zarr.core.dtype.common.UnstableSpecificationWarning")
+@given(data=st.data())
+async def test_mask_indexing(data: st.DataObject) -> None:
+    """Property test comparing mask indexing (read and write) against a NumPy oracle."""
+    zarray = data.draw(
+        st.one_of(
+            simple_arrays(shapes=npst.array_shapes(min_dims=1, max_dims=4, min_side=1)),
+            rectilinear_arrays(
+                shapes=npst.array_shapes(min_dims=1, max_dims=3, min_side=1, max_side=20)
+            ),
+        )
+    )
+    nparray = zarray[...]
+    mask = data.draw(numpy_arrays(shapes=st.just(nparray.shape), dtype=np.dtype(bool)))
+    expected = nparray[mask]
+
+    # Dedicated sync read method (get_mask_selection)
+    actual_get = zarray.get_mask_selection(mask)
+    assert_array_equal(expected, actual_get)
+
+    # Indexer property sync read (.vindex[mask])
+    actual_vindex = zarray.vindex[mask]
+    assert_array_equal(expected, actual_vindex)
+
+    # Async read method (get_mask_selection)
+    async_zarray = zarray._async_array
+    actual_async_get = await async_zarray.get_mask_selection(mask)
+    assert_array_equal(expected, actual_async_get)
+
+    # Async indexer property read (.vindex.getitem(mask))
+    actual_async_vindex = await async_zarray.vindex.getitem(mask)
+    assert_array_equal(expected, actual_async_vindex)
+
+    # Generate new data to write
+    k = int(np.count_nonzero(mask))
+    new_data = data.draw(numpy_arrays(shapes=st.just((k,)), dtype=nparray.dtype))
+    nparray_copy = nparray.copy()
+    nparray_copy[mask] = new_data
+
+    # Dedicated sync write method (set_mask_selection)
+    zarray[...] = nparray
+    zarray.set_mask_selection(mask, new_data)
+    assert_array_equal(nparray_copy, zarray[...])
+
+    # Indexer property sync write (.vindex[mask] = ...)
+    zarray[...] = nparray
+    zarray.vindex[mask] = new_data
+    assert_array_equal(nparray_copy, zarray[...])
+

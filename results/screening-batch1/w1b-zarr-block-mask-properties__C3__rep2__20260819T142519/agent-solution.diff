+@settings(deadline=None)
+@pytest.mark.filterwarnings("ignore::zarr.core.dtype.common.UnstableSpecificationWarning")
+@given(data=st.data())
+def test_block_indexing(data: st.DataObject) -> None:
+    """Property test comparing block indexing (read and write) against a NumPy oracle."""
+    zarray = data.draw(
+        st.one_of(
+            simple_arrays(shapes=npst.array_shapes(max_dims=4, min_side=1)),
+            rectilinear_arrays(shapes=npst.array_shapes(max_dims=3, min_side=1, max_side=20)),
+        )
+    )
+    nparray = zarray[...]
+    cdata_shape = tuple(d.nchunks for d in zarray._chunk_grid._dimensions)
+    indexer = data.draw(block_indices(cdata_shape=cdata_shape))
+
+    np_indexer = block_selection_to_numpy_indices(
+        indexer, nparray.shape, zarray._chunk_grid._dimensions
+    )
+    expected = nparray[np_indexer]
+
+    # Dedicated read method
+    actual_get = zarray.get_block_selection(indexer)
+    assert_array_equal(expected, actual_get)
+
+    # Indexer property read (.blocks[...])
+    actual_blocks = zarray.blocks[indexer]
+    assert_array_equal(expected, actual_blocks)
+
+    # Generate new data to write
+    new_data = data.draw(numpy_arrays(shapes=st.just(actual_get.shape), dtype=nparray.dtype))
+    nparray_copy = nparray.copy()
+    nparray_copy[np_indexer] = new_data
+
+    # Dedicated write method (set_block_selection)
+    zarray[...] = nparray
+    zarray.set_block_selection(indexer, new_data)
+    assert_array_equal(nparray_copy, zarray[...])
+
+    # Indexer property write (.blocks[...] = ...)
+    zarray[...] = nparray
+    zarray.blocks[indexer] = new_data
+    assert_array_equal(nparray_copy, zarray[...])
+

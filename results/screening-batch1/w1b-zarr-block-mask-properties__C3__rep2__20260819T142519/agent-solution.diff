+def block_selection_to_numpy_indices(
+    selection: BasicSelection,
+    shape: tuple[int, ...],
+    dimensions: tuple[DimensionGrid, ...],
+) -> tuple[slice, ...]:
+    """Translate a Zarr block selection into the equivalent NumPy slice tuple."""
+    norm_sel = replace_ellipsis(selection, shape)
+    np_slices: list[slice] = []
+    for dim_sel, dim_len, dim_grid in zip(norm_sel, shape, dimensions, strict=True):
+        dim_numchunks = dim_grid.nchunks
+        if is_integer(dim_sel):
+            if dim_sel < 0:
+                dim_sel = dim_numchunks + dim_sel
+            start = dim_grid.chunk_offset(dim_sel)
+            stop = start + dim_grid.chunk_size(dim_sel)
+            np_slices.append(slice(start, stop))
+        elif is_slice(dim_sel):
+            start = dim_sel.start if dim_sel.start is not None else 0
+            stop = dim_sel.stop if dim_sel.stop is not None else dim_numchunks
+            if start < 0:
+                start = dim_numchunks + start
+            if stop < 0:
+                stop = dim_numchunks + stop
+            start_offset = dim_grid.chunk_offset(start) if start < dim_numchunks else dim_len
+            stop_offset = dim_grid.chunk_offset(stop) if stop < dim_numchunks else dim_len
+            np_slices.append(slice(start_offset, stop_offset))
+        else:
+            raise IndexError(f"Unsupported selection item for block indexing: {dim_sel!r}")
+    return tuple(np_slices)
+
+
+@st.composite
+def block_indices(draw: st.DrawFn, *, cdata_shape: tuple[int, ...]) -> Any:
+    """Generate valid block selections for an array with chunk grid shape `cdata_shape`."""
+    ndim = len(cdata_shape)
+    if ndim == 0:
+        return draw(st.sampled_from([(), Ellipsis, (Ellipsis,)]))
+
+    dim_selectors = []
+    for nchunks in cdata_shape:
+        int_strategy = st.integers(min_value=-nchunks, max_value=nchunks - 1)
+        start_strategy = st.none() | st.integers(min_value=-nchunks, max_value=nchunks - 1)
+        stop_strategy = st.none() | st.integers(min_value=-nchunks, max_value=nchunks + 2)
+        slice_strategy = st.builds(
+            slice,
+            start_strategy,
+            stop_strategy,
+            st.sampled_from([None, 1]),
+        )
+        dim_selectors.append(draw(st.one_of(int_strategy, slice_strategy)))
+
+    form = draw(st.sampled_from(["full", "single", "ellipsis", "prefix"]))
+    if form == "single":
+        return dim_selectors[0]
+    elif form == "ellipsis":
+        pos = draw(st.integers(min_value=0, max_value=ndim))
+        res = list(dim_selectors)
+        res.insert(pos, Ellipsis)
+        if draw(st.booleans()) and ndim > 1:
+            drop_idx = draw(st.integers(min_value=0, max_value=len(res) - 1))
+            if res[drop_idx] is not Ellipsis:
+                res.pop(drop_idx)
+        return tuple(res)
+    elif form == "prefix" and ndim > 1:
+        length = draw(st.integers(min_value=1, max_value=ndim - 1))
+        return tuple(dim_selectors[:length])
+    else:
+        return tuple(dim_selectors)
+

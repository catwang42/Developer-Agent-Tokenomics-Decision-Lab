+@st.composite
+def block_indices(
+    draw: st.DrawFn,
+    *,
+    shape: tuple[int, ...],
+    cdata_shape: tuple[int, ...],
+) -> Any:
+    """Generate valid block selections for a given array chunk grid.
+
+    Block indexing is basic indexing over the grid of chunks. It only supports integers
+    and step-1 slices whose start references an existing chunk.
+    """
+    ndim = len(shape)
+    assert ndim == len(cdata_shape)
+    assert all(n > 0 for n in cdata_shape)
+
+    dim_strategies = []
+    for nchunks in cdata_shape:
+        int_strategy = st.integers(min_value=-nchunks, max_value=nchunks - 1)
+        start_strategy = st.none() | st.integers(min_value=-nchunks, max_value=nchunks - 1)
+        stop_strategy = st.none() | st.integers(min_value=-nchunks, max_value=nchunks + 1)
+        step_strategy = st.none() | st.just(1)
+        slice_strategy = st.builds(slice, start_strategy, stop_strategy, step_strategy)
+        dim_strategies.append(int_strategy | slice_strategy)
+
+    if ndim == 1:
+        return draw(dim_strategies[0] | st.tuples(dim_strategies[0]))
+
+    elements = [draw(s) for s in dim_strategies]
+    mode = draw(st.sampled_from(["full", "short", "ellipsis"]))
+    if mode == "full":
+        return tuple(elements)
+    elif mode == "short":
+        k = draw(st.integers(min_value=1, max_value=ndim - 1))
+        return tuple(elements[:k])
+    else:  # ellipsis
+        k = draw(st.integers(min_value=0, max_value=ndim))
+        res = list(elements)
+        if draw(st.booleans()):
+            res[k : k + 1] = [...]
+        else:
+            res.insert(k, ...)
+            if len(res) > ndim:
+                res = res[:ndim]
+        return tuple(res)
+

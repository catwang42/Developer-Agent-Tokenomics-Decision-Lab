+@pytest.mark.asyncio
+@settings(deadline=None)
+@pytest.mark.filterwarnings("ignore::zarr.core.dtype.common.UnstableSpecificationWarning")
+@given(data=st.data())
+async def test_block_indexing(data: st.DataObject) -> None:
+    """Property test for block indexing (reading and writing) against NumPy oracle."""
+    zarray = data.draw(
+        st.one_of(
+            simple_arrays(shapes=npst.array_shapes(max_dims=4, min_side=1)),
+            rectilinear_arrays(shapes=npst.array_shapes(max_dims=4, min_side=1, max_side=20)),
+        )
+    )
+    nparray = zarray[:]
+    indexer = data.draw(block_indices(shape=nparray.shape, cdata_shape=zarray.cdata_shape))
+    np_indexer = block_indexer_to_numpy(zarray, indexer)
+
+    # 1. Reading selection: compare .blocks[...] and .get_block_selection(...) to NumPy oracle
+    expected = nparray[np_indexer]
+    actual_blocks = zarray.blocks[indexer]
+    assert_array_equal(expected, actual_blocks)
+
+    actual_get = zarray.get_block_selection(indexer)
+    assert_array_equal(expected, actual_get)
+
+    # 2. Writing selection: dedicated method (set_block_selection)
+    new_data_1 = data.draw(numpy_arrays(shapes=st.just(actual_blocks.shape), dtype=nparray.dtype))
+    zarray.set_block_selection(indexer, new_data_1)
+    nparray[np_indexer] = new_data_1
+    assert_array_equal(nparray, zarray[:])
+
+    # 3. Writing selection: indexer property (.blocks[...] = ...)
+    new_data_2 = data.draw(numpy_arrays(shapes=st.just(actual_blocks.shape), dtype=nparray.dtype))
+    zarray.blocks[indexer] = new_data_2
+    nparray[np_indexer] = new_data_2
+    assert_array_equal(nparray, zarray[:])
+
+

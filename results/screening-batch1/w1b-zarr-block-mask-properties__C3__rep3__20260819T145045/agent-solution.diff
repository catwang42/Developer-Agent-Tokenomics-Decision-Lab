+@pytest.mark.filterwarnings("ignore::zarr.core.dtype.common.UnstableSpecificationWarning")
+@given(data=st.data())
+async def test_mask_indexing(data: st.DataObject) -> None:
+    """Property test for mask indexing (reading and writing) against NumPy oracle."""
+    zarray = data.draw(
+        st.one_of(
+            simple_arrays(shapes=npst.array_shapes(max_dims=4, min_side=1)),
+            rectilinear_arrays(shapes=npst.array_shapes(max_dims=3, min_side=1, max_side=20)),
+        )
+    )
+    nparray = zarray[:]
+    mask = data.draw(npst.arrays(dtype=np.bool_, shape=st.just(nparray.shape)))
+
+    # 1. Reading selection: compare .vindex[mask] and .get_mask_selection(mask) to NumPy oracle
+    expected = nparray[mask]
+    actual_vindex = zarray.vindex[mask]
+    assert_array_equal(expected, actual_vindex)
+
+    actual_get = zarray.get_mask_selection(mask)
+    assert_array_equal(expected, actual_get)
+
+    # Async reading
+    async_zarray = zarray._async_array
+    actual_async_get = await async_zarray.get_mask_selection(mask)
+    assert_array_equal(expected, actual_async_get)
+    actual_async_vindex = await async_zarray.vindex.getitem(mask)
+    assert_array_equal(expected, actual_async_vindex)
+
+    # 2. Writing selection: dedicated method (set_mask_selection)
+    new_data_1 = data.draw(numpy_arrays(shapes=st.just(expected.shape), dtype=nparray.dtype))
+    zarray.set_mask_selection(mask, new_data_1)
+    nparray[mask] = new_data_1
+    assert_array_equal(nparray, zarray[:])
+
+    # 3. Writing selection: indexer property (.vindex[mask] = ...)
+    new_data_2 = data.draw(numpy_arrays(shapes=st.just(expected.shape), dtype=nparray.dtype))
+    zarray.vindex[mask] = new_data_2
+    nparray[mask] = new_data_2
+    assert_array_equal(nparray, zarray[:])

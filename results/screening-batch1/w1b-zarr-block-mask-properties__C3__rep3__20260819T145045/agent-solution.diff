+def block_indexer_to_numpy(zarray: zarr.Array, selection: Any) -> tuple[slice, ...]:
+    """Map a block selection on a Zarr array to the equivalent NumPy slice tuple."""
+    selection_norm = replace_ellipsis(selection, zarray.shape)
+    np_slices: list[slice] = []
+    for dim_sel, dim_len, dim_grid in zip(
+        selection_norm, zarray.shape, zarray._chunk_grid._dimensions, strict=True
+    ):
+        dim_numchunks = dim_grid.nchunks
+        if is_integer(dim_sel):
+            k = int(dim_sel)
+            if k < 0:
+                k += dim_numchunks
+            start = dim_grid.chunk_offset(k)
+            stop = start + dim_grid.chunk_size(k)
+            slice_ = slice(start, stop)
+        elif is_slice(dim_sel):
+            start = dim_sel.start if dim_sel.start is not None else 0
+            stop = dim_sel.stop if dim_sel.stop is not None else dim_numchunks
+            if start < 0:
+                start += dim_numchunks
+            if stop < 0:
+                stop += dim_numchunks
+            start = dim_grid.chunk_offset(start) if start < dim_numchunks else dim_len
+            stop = dim_grid.chunk_offset(stop) if stop < dim_numchunks else dim_len
+            slice_ = slice(start, stop)
+        else:
+            raise TypeError(f"Unexpected selection element: {dim_sel!r}")
+
+        start_norm, stop_norm, _ = slice_.indices(dim_len)
+        np_slices.append(slice(start_norm, stop_norm))
+
+    return tuple(np_slices)
+

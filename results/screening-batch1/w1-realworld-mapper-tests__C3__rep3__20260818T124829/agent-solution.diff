+import articleMapper from '../../app/routes/article/article.mapper';
+import authorMapper from '../../app/routes/article/author.mapper';
+
+describe('Mappers', () => {
+  describe('authorMapper', () => {
+    test('should map author fields and set following to false when user id is omitted', () => {
+      // Given
+      const author = {
+        username: 'johndoe',
+        bio: 'Software engineer',
+        image: 'https://example.com/avatar.png',
+        followedBy: [{ id: 1 }, { id: 2 }],
+      };
+
+      // When
+      const result = authorMapper(author);
+
+      // Then
+      expect(result).toEqual({
+        username: 'johndoe',
+        bio: 'Software engineer',
+        image: 'https://example.com/avatar.png',
+        following: false,
+      });
+      expect(result.following).toBe(false);
+    });
+
+    test('should map author fields and set following to false when user id is undefined', () => {
+      // Given
+      const author = {
+        username: 'johndoe',
+        bio: null,
+        image: null,
+        followedBy: [{ id: 1 }],
+      };
+
+      // When
+      const result = authorMapper(author, undefined);
+
+      // Then
+      expect(result).toEqual({
+        username: 'johndoe',
+        bio: null,
+        image: null,
+        following: false,
+      });
+      expect(result.following).toBe(false);
+    });
+
+    test('should set following to true when the requesting user is in followedBy', () => {
+      // Given
+      const requestingUserId = 42;
+      const author = {
+        username: 'janedoe',
+        bio: 'Tech enthusiast',
+        image: 'https://example.com/jane.png',
+        followedBy: [{ id: 10 }, { id: 42 }, { id: 99 }],
+      };
+
+      // When
+      const result = authorMapper(author, requestingUserId);
+
+      // Then
+      expect(result).toEqual({
+        username: 'janedoe',
+        bio: 'Tech enthusiast',
+        image: 'https://example.com/jane.png',
+        following: true,
+      });
+      expect(result.following).toBe(true);
+    });
+
+    test('should set following to false when the requesting user is not in followedBy', () => {
+      // Given
+      const requestingUserId = 42;
+      const author = {
+        username: 'janedoe',
+        bio: 'Tech enthusiast',
+        image: 'https://example.com/jane.png',
+        followedBy: [{ id: 10 }, { id: 99 }],
+      };
+
+      // When
+      const result = authorMapper(author, requestingUserId);
+
+      // Then
+      expect(result).toEqual({
+        username: 'janedoe',
+        bio: 'Tech enthusiast',
+        image: 'https://example.com/jane.png',
+        following: false,
+      });
+      expect(result.following).toBe(false);
+    });
+
+    test('should set following to false when followedBy is empty and user id is provided', () => {
+      // Given
+      const requestingUserId = 42;
+      const author = {
+        username: 'solo_author',
+        bio: 'Solo dev',
+        image: null,
+        followedBy: [],
+      };
+
+      // When
+      const result = authorMapper(author, requestingUserId);
+
+      // Then
+      expect(result).toEqual({
+        username: 'solo_author',
+        bio: 'Solo dev',
+        image: null,
+        following: false,
+      });
+      expect(result.following).toBe(false);
+    });
+  });
+

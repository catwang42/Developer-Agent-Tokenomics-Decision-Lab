+      // Then
+      expect(result).toEqual({
+        slug: 'public-article',
+        title: 'Public Article',
+        description: 'Public description',
+        body: 'Public body',
+        tagList: ['general'],
+        createdAt,
+        updatedAt,
+        favorited: false,

+def level_to_int(level: Union[ObjectReferenceLevel, int]) -> int:
+    """Coerce a reference level (enum member or plain int) to an int."""
+    # If it's an ObjectReferenceLevel, get the value. Otherwise, assume it's
+    # an int.

+
+def infer_dialect_name(segment: BaseSegment) -> str:
+    """Best effort guess at which dialect parsed the given segment.
+
+    This exists purely to support the deprecated segment methods, which
+    don't have access to a dialect. We look at the module which defines
+    the segment's class, and failing that, the classes of any descendants.
+    """
+    name = _module_dialect_name(segment)
+    if name:
+        return name
+    for child in segment.recursive_crawl_all():
+        name = _module_dialect_name(child)
+        if name:
+            return name
+    return _DEFAULT_DIALECT

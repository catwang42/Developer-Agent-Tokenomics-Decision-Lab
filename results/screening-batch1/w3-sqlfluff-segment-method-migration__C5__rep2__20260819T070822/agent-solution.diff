+def _module_dialect_name(segment: BaseSegment) -> Optional[str]:
+    """Return the dialect which defines this segment's class (if not ansi)."""
+    module = type(segment).__module__
+    if module.startswith(_DIALECT_MODULE_PREFIX):
+        name = module[len(_DIALECT_MODULE_PREFIX) :]
+        if name != _DEFAULT_DIALECT:
+            return name
+    return None

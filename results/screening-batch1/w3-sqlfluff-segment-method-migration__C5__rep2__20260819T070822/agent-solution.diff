+def warn_deprecated_segment_method(name: str) -> None:
+    """Warn that a reference/alias resolution segment method is deprecated.
+
+    The logic behind these methods now lives in this module as
+    dialect-dispatched free functions. The methods remain as thin wrappers
+    for backward compatibility.

+@st.composite
+def block_indices(draw: st.DrawFn, *, grid_shape: tuple[int, ...]) -> Any:
+    """Generate valid block indices for an array with the given chunk grid shape.
+
+    Block indexing is basic indexing over the grid of chunks, supporting only integers
+    and step-1 slices whose start references an existing chunk.
+    """
+    ndim = len(grid_shape)
+    if ndim == 0:
+        return draw(st.sampled_from([(), (Ellipsis,), Ellipsis]))
+
+    dim_strats = []
+    for nchunks in grid_shape:
+        int_strat = st.integers(min_value=-nchunks, max_value=nchunks - 1)
+        slice_strat = st.builds(
+            slice,
+            st.none() | st.integers(min_value=-nchunks, max_value=nchunks - 1),
+            st.none() | st.integers(min_value=-nchunks, max_value=nchunks),
+            st.sampled_from([None, 1]),
+        )
+        dim_strats.append(int_strat | slice_strat)
+
+    full_tuple = draw(st.tuples(*dim_strats))
+
+    syntax_mode = draw(st.sampled_from(["full", "bare_or_partial", "ellipsis"]))
+    if syntax_mode == "full":
+        return full_tuple
+    elif syntax_mode == "bare_or_partial":
+        if ndim == 1:
+            return full_tuple[0]
+        else:
+            length = draw(st.integers(min_value=1, max_value=ndim))
+            return full_tuple[:length]
+    else:  # ellipsis
+        if ndim == 1:
+            return draw(
+                st.sampled_from(
+                    [
+                        (Ellipsis, full_tuple[0]),
+                        (full_tuple[0], Ellipsis),
+                        (Ellipsis,),
+                        Ellipsis,
+                    ]
+                )
+            )
+        else:
+            insert_pos = draw(st.integers(min_value=0, max_value=ndim))
+            num_drop = draw(st.integers(min_value=0, max_value=ndim))
+            kept = list(full_tuple)
+            del kept[insert_pos : insert_pos + num_drop]
+            kept.insert(insert_pos, Ellipsis)
+            return tuple(kept)
+
+
+def block_selection_to_numpy_slices(
+    selection: Any,
+    shape: tuple[int, ...],
+    chunk_grid: ChunkGrid,
+) -> tuple[slice, ...]:
+    """NumPy oracle: translate a block selection into equivalent NumPy array slices."""
+    dim_grids = chunk_grid._dimensions
+    selection_normalized = replace_ellipsis(selection, shape)
+    selection_normalized = replace_lists(selection_normalized)
+
+    np_slices: list[slice] = []
+    for dim_sel, dim_len, dim_grid in zip(selection_normalized, shape, dim_grids, strict=True):
+        dim_numchunks = dim_grid.nchunks
+
+        if is_integer(dim_sel):
+            norm_sel = int(dim_sel)
+            if norm_sel < 0:
+                norm_sel = dim_numchunks + norm_sel
+            start = dim_grid.chunk_offset(norm_sel)
+            stop = start + dim_grid.chunk_size(norm_sel)
+            np_slices.append(slice(start, stop))
+        elif is_slice(dim_sel):
+            start = dim_sel.start if dim_sel.start is not None else 0
+            stop = dim_sel.stop if dim_sel.stop is not None else dim_numchunks
+
+            if start < 0:
+                start = dim_numchunks + start
+            if stop < 0:
+                stop = dim_numchunks + stop
+
+            start_arr = dim_grid.chunk_offset(start) if start < dim_numchunks else dim_len
+            stop_arr = dim_grid.chunk_offset(stop) if stop < dim_numchunks else dim_len
+            np_slices.append(slice(start_arr, stop_arr))
+        else:
+            raise TypeError(f"Unexpected selection type {type(dim_sel)}")
+
+    return tuple(np_slices)
+

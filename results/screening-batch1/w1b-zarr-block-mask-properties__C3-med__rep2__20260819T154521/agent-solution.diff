+@pytest.mark.filterwarnings("ignore::zarr.core.dtype.common.UnstableSpecificationWarning")
+@pytest.mark.filterwarnings("ignore::zarr.errors.ZarrUserWarning")
+@given(data=st.data())
+def test_get_block_selection(data: st.DataObject) -> None:
+    """Compare reading a block selection against a NumPy oracle."""
+    zarray = data.draw(
+        st.one_of(
+            simple_arrays(shapes=npst.array_shapes(min_dims=1, max_dims=4, min_side=1)),
+            rectilinear_arrays(
+                shapes=npst.array_shapes(min_dims=1, max_dims=3, min_side=1, max_side=20)
+            ),
+        )
+    )
+    nparray = zarray[:]
+    indexer = data.draw(block_indices(grid_shape=zarray._chunk_grid.grid_shape))
+    np_idx = block_selection_to_numpy_slices(indexer, nparray.shape, zarray._chunk_grid)
+    expected = nparray[np_idx]
+
+    # Dedicated method
+    actual_method = zarray.get_block_selection(indexer)
+    assert_array_equal(expected, actual_method)
+
+    # Indexer property
+    actual_blocks = zarray.blocks[indexer]
+    assert_array_equal(expected, actual_blocks)
+
+
+@pytest.mark.filterwarnings("ignore::zarr.core.dtype.common.UnstableSpecificationWarning")
+@pytest.mark.filterwarnings("ignore::zarr.errors.ZarrUserWarning")
+@given(data=st.data())
+def test_set_block_selection(data: st.DataObject) -> None:
+    """Compare writing a block selection against a NumPy oracle."""
+    zarray = data.draw(
+        st.one_of(
+            simple_arrays(shapes=npst.array_shapes(min_dims=1, max_dims=4, min_side=1)),
+            rectilinear_arrays(
+                shapes=npst.array_shapes(min_dims=1, max_dims=3, min_side=1, max_side=20)
+            ),
+        )
+    )
+    nparray = zarray[:]
+    indexer = data.draw(block_indices(grid_shape=zarray._chunk_grid.grid_shape))
+    np_idx = block_selection_to_numpy_slices(indexer, nparray.shape, zarray._chunk_grid)
+    expected = nparray[np_idx]
+    new_data = data.draw(numpy_arrays(shapes=st.just(expected.shape), dtype=nparray.dtype))
+
+    # Dedicated method: set_block_selection
+    nparray_copy = nparray.copy()
+    nparray_copy[np_idx] = new_data
+    zarray.set_block_selection(indexer, new_data)
+    assert_array_equal(nparray_copy, zarray[:])
+
+    # Indexer property: blocks[...] = ...
+    zarray[:] = nparray
+    zarray.blocks[indexer] = new_data
+    assert_array_equal(nparray_copy, zarray[:])
+

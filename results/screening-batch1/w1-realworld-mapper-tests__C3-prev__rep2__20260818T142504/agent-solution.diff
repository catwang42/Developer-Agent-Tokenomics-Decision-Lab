+import articleMapper from '../../app/routes/article/article.mapper';
+import authorMapper from '../../app/routes/article/author.mapper';
+
+describe('Author Mapper', () => {
+  test('maps author correctly when id is absent (undefined)', () => {
+    const authorInput = {
+      username: 'johndoe',
+      bio: 'Developer and writer',
+      image: 'https://example.com/avatar.jpg',
+      followedBy: [{ id: 1 }, { id: 2 }],
+    };
+
+    const mapped = authorMapper(authorInput);
+
+    expect(mapped).toEqual({
+      username: 'johndoe',
+      bio: 'Developer and writer',
+      image: 'https://example.com/avatar.jpg',
+      following: false,
+    });
+  });
+
+  test('maps author correctly when id is present and user is in followedBy', () => {
+    const authorInput = {
+      username: 'janedoe',
+      bio: null,
+      image: null,
+      followedBy: [{ id: 10 }, { id: 20 }],
+    };
+
+    const mapped = authorMapper(authorInput, 10);
+
+    expect(mapped).toEqual({
+      username: 'janedoe',
+      bio: null,
+      image: null,
+      following: true,
+    });
+  });
+
+  test('maps author correctly when id is present and user is not in followedBy', () => {
+    const authorInput = {
+      username: 'bobsmith',
+      bio: 'Code enthusiast',
+      image: 'https://example.com/bob.jpg',
+      followedBy: [{ id: 10 }, { id: 20 }],
+    };
+
+    const mapped = authorMapper(authorInput, 99);
+
+    expect(mapped).toEqual({
+      username: 'bobsmith',
+      bio: 'Code enthusiast',
+      image: 'https://example.com/bob.jpg',
+      following: false,
+    });
+  });
+});
+

+import articleMapper from '../../app/routes/article/article.mapper';
+import authorMapper from '../../app/routes/article/author.mapper';
+
+describe('Author and Article Mappers', () => {
+  describe('authorMapper', () => {
+    test('should map author correctly when id is not provided (following is false)', () => {
+      // Given
+      const author = {
+        username: 'john_doe',
+        bio: 'Software engineer and writer',
+        image: 'https://api.realworld.io/images/smiley-cyrus.jpg',
+        followedBy: [{ id: 1 }],
+      };
+
+      // When
+      const result = authorMapper(author);
+
+      // Then
+      expect(result).toEqual({
+        username: 'john_doe',
+        bio: 'Software engineer and writer',
+        image: 'https://api.realworld.io/images/smiley-cyrus.jpg',
+        following: false,
+      });
+    });
+
+    test('should map author correctly when id is undefined (following is false)', () => {
+      // Given
+      const author = {
+        username: 'john_doe',
+        bio: 'Software engineer and writer',
+        image: 'https://api.realworld.io/images/smiley-cyrus.jpg',
+        followedBy: [{ id: 1 }],
+      };
+
+      // When
+      const result = authorMapper(author, undefined);
+
+      // Then
+      expect(result).toEqual({
+        username: 'john_doe',
+        bio: 'Software engineer and writer',
+        image: 'https://api.realworld.io/images/smiley-cyrus.jpg',
+        following: false,
+      });
+    });
+
+    test('should map author with following true when requesting user is in followedBy', () => {
+      // Given
+      const author = {
+        username: 'jane_doe',
+        bio: 'Tech enthusiast',
+        image: 'https://api.realworld.io/images/demo-avatar.png',
+        followedBy: [{ id: 10 }, { id: 42 }],
+      };
+      const currentUserId = 42;
+
+      // When
+      const result = authorMapper(author, currentUserId);
+
+      // Then
+      expect(result).toEqual({
+        username: 'jane_doe',
+        bio: 'Tech enthusiast',
+        image: 'https://api.realworld.io/images/demo-avatar.png',
+        following: true,
+      });
+    });

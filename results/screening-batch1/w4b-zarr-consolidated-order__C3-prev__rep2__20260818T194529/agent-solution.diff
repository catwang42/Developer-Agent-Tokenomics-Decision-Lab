diff --git a/tests/test_metadata/test_consolidated.py b/tests/test_metadata/test_consolidated.py
index e6087435..6eb8bec9 100644
--- a/tests/test_metadata/test_consolidated.py
+++ b/tests/test_metadata/test_consolidated.py
@@ -839,3 +839,40 @@ async def test_open_group_in_non_consolidating_stores() -> None:
     # Opening a group with use_consolidated=True should fail
     with pytest.raises(ValueError, match="doesn't support consolidated metadata"):
         await AsyncGroup.open(memory_store, use_consolidated=True)
+
+
+def test_consolidated_metadata_permutation_independence() -> None:
+    import itertools
+
+    flat_dict_base = {
+        "a": GroupMetadata(zarr_format=3).to_dict(),
+        "A": GroupMetadata(zarr_format=3).to_dict(),
+        "a/x": GroupMetadata(zarr_format=3).to_dict(),
+        "A/y": GroupMetadata(zarr_format=3).to_dict(),
+        "a/z": GroupMetadata(zarr_format=3).to_dict(),
+    }
+
+    keys = list(flat_dict_base.keys())
+    results = set()
+    for p in itertools.permutations(keys):
+        perm_dict = {k: flat_dict_base[k] for k in p}
+        d = {"kind": "inline", "must_understand": False, "metadata": perm_dict}
+        cm = ConsolidatedMetadata.from_dict(d)
+
+        top_keys = tuple(cm.metadata.keys())
+        a_child = cm.metadata.get("a")
+        a_children = (
+            tuple(a_child.consolidated_metadata.metadata.keys())
+            if isinstance(a_child, GroupMetadata) and a_child.consolidated_metadata
+            else ()
+        )
+        A_child = cm.metadata.get("A")
+        A_children = (
+            tuple(A_child.consolidated_metadata.metadata.keys())
+            if isinstance(A_child, GroupMetadata) and A_child.consolidated_metadata
+            else ()
+        )
+        results.add((top_keys, a_children, A_children))
+
+    assert len(results) == 1
+    assert ("a/x" not in results) and ("a/z" not in results)

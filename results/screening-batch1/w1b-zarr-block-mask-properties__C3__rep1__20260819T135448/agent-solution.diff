+def block_selection_to_numpy_selection(
+    zarray: zarr.Array, selection: Any
+) -> tuple[slice, ...]:
+    """Convert a block selection to the equivalent NumPy slice tuple for indexing the array."""
+    shape = zarray.shape
+    dim_grids = zarray._chunk_grid._dimensions
+    norm_sel = replace_ellipsis(selection, shape)
+    np_slices = []
+    for dim_sel, dim_len, dim_grid in zip(norm_sel, shape, dim_grids, strict=True):
+        dim_numchunks = dim_grid.nchunks
+        if is_integer(dim_sel):
+            c = dim_sel if dim_sel >= 0 else dim_numchunks + dim_sel
+            start = dim_grid.chunk_offset(c)
+            stop = start + dim_grid.chunk_size(c)
+            np_slices.append(slice(start, stop))
+        elif is_slice(dim_sel):
+            start = dim_sel.start if dim_sel.start is not None else 0
+            stop = dim_sel.stop if dim_sel.stop is not None else dim_numchunks
+            if start < 0:
+                start = dim_numchunks + start
+            if stop < 0:
+                stop = dim_numchunks + stop
+            start_elem = dim_grid.chunk_offset(start) if start < dim_numchunks else dim_len
+            stop_elem = dim_grid.chunk_offset(stop) if stop < dim_numchunks else dim_len
+            np_slices.append(slice(start_elem, stop_elem))
+        else:
+            raise TypeError(f"Unsupported block selection type: {type(dim_sel)!r}")
+    return tuple(np_slices)
+

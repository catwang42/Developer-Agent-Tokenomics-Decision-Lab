+@st.composite
+def block_indices(
+    draw: st.DrawFn,
+    *,
+    numblocks: tuple[int, ...],
+    allow_ellipsis: bool = True,
+) -> Any:
+    """Generate valid block selections over the grid of chunks.
+
+    Stricter than NumPy basic indexing: only integers and step-1 slices whose
+    start references an existing chunk are supported.
+    """
+    ndim = len(numblocks)
+    if ndim == 0:
+        return ()
+
+    dim_strategies = []
+    for nchunks in numblocks:
+        int_strategy = st.integers(-nchunks, nchunks - 1)
+        start_strategy = st.none() | st.integers(-nchunks, nchunks - 1)
+        stop_strategy = st.none() | st.integers(-nchunks, nchunks + 2)
+        step_strategy = st.sampled_from([None, 1])
+        slice_strategy = st.builds(slice, start_strategy, stop_strategy, step_strategy)
+        dim_strategies.append(int_strategy | slice_strategy)
+
+    modes = ["full", "prefix", "single"]
+    if allow_ellipsis and ndim > 0:
+        modes.append("ellipsis")
+    mode = draw(st.sampled_from(modes))
+
+    if mode == "single" and ndim == 1:
+        return draw(dim_strategies[0])
+    elif mode == "ellipsis" and allow_ellipsis:
+        l = draw(st.integers(0, ndim))
+        r = draw(st.integers(0, ndim - l))
+        left = [draw(dim_strategies[i]) for i in range(l)]
+        right = [draw(dim_strategies[ndim - r + i]) for i in range(r)]
+        res = tuple(left) + (Ellipsis,) + tuple(right)
+        if len(res) == 1 and draw(st.booleans()):
+            return Ellipsis
+        return res
+    elif mode == "prefix":
+        k = draw(st.integers(1, ndim))
+        return tuple(draw(dim_strategies[i]) for i in range(k))
+    else:
+        return tuple(draw(strat) for strat in dim_strategies)
+

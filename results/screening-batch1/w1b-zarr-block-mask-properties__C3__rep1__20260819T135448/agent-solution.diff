+@settings(deadline=None)
+@pytest.mark.filterwarnings("ignore::zarr.core.dtype.common.UnstableSpecificationWarning")
+@given(data=st.data())
+def test_block_indexing(data: st.DataObject) -> None:
+    zarray = data.draw(
+        st.one_of(
+            simple_arrays(shapes=npst.array_shapes(max_dims=4, min_side=1)),
+            rectilinear_arrays(shapes=npst.array_shapes(max_dims=3, min_side=1, max_side=20)),
+        )
+    )
+    assume(zarray.shards is None)
+    nparray = zarray[:]
+    numblocks = tuple(d.nchunks for d in zarray._chunk_grid._dimensions)
+    selection = data.draw(block_indices(numblocks=numblocks))
+    np_selection = block_selection_to_numpy_selection(zarray, selection)
+
+    # 1. Read direction: compare against numpy oracle
+    expected = nparray[np_selection]
+    actual_blocks = zarray.blocks[selection]
+    actual_method = zarray.get_block_selection(selection)
+    assert_array_equal(expected, actual_blocks)
+    assert_array_equal(expected, actual_method)
+
+    # 2. Write direction: compare against numpy oracle
+    new_data = data.draw(numpy_arrays(shapes=st.just(expected.shape), dtype=nparray.dtype))
+
+    # Test .blocks[...] = ...
+    nparray_copy1 = nparray.copy()
+    nparray_copy1[np_selection] = new_data
+    zarray[:] = nparray
+    zarray.blocks[selection] = new_data
+    assert_array_equal(nparray_copy1, zarray[:])
+
+    # Test .set_block_selection(...)
+    nparray_copy2 = nparray.copy()
+    nparray_copy2[np_selection] = new_data
+    zarray[:] = nparray
+    zarray.set_block_selection(selection, new_data)
+    assert_array_equal(nparray_copy2, zarray[:])
+

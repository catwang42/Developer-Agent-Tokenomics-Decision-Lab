+import articleMapper from '../../app/routes/article/article.mapper';
+import authorMapper from '../../app/routes/article/author.mapper';
+
+describe('AuthorMapper', () => {
+  test('should not follow the author when no id is given', () => {
+    // Given
+    const author = {
+      username: 'RealWorld',
+      bio: 'My happy life',
+      image: null,
+      followedBy: [{ id: 123 }],
+    };
+
+    // When
+    const expected = {
+      username: 'RealWorld',
+      bio: 'My happy life',
+      image: null,
+      following: false,
+    };
+
+    // Then
+    expect(authorMapper(author)).toEqual(expected);
+  });
+
+  test('should follow the author when the user is in followedBy', () => {
+    // Given
+    const author = {
+      username: 'RealWorld',
+      bio: 'My happy life',
+      image: 'https://realworld.io/avatar.png',
+      followedBy: [{ id: 456 }, { id: 123 }],
+    };
+    const id = 123;
+
+    // When
+    const expected = {
+      username: 'RealWorld',
+      bio: 'My happy life',
+      image: 'https://realworld.io/avatar.png',
+      following: true,
+    };
+
+    // Then
+    expect(authorMapper(author, id)).toEqual(expected);
+  });
+
+  test('should not follow the author when the user is not in followedBy', () => {
+    // Given
+    const author = {
+      username: 'RealWorld',
+      bio: null,
+      image: null,
+      followedBy: [{ id: 456 }],
+    };
+    const id = 123;
+
+    // When
+    const expected = {
+      username: 'RealWorld',
+      bio: null,
+      image: null,
+      following: false,
+    };
+
+    // Then
+    expect(authorMapper(author, id)).toEqual(expected);
+  });
+
+  test('should not follow the author when followedBy is empty', () => {
+    // Given
+    const author = {
+      username: 'RealWorld',
+      bio: 'My happy life',
+      image: null,
+      followedBy: [],
+    };
+    const id = 123;
+
+    // When
+    const expected = {
+      username: 'RealWorld',
+      bio: 'My happy life',
+      image: null,
+      following: false,
+    };
+
+    // Then
+    expect(authorMapper(author, id)).toEqual(expected);
+  });
+
+  test('should only expose the mapped fields of the author', () => {
+    // Given
+    const author = {
+      id: 123,
+      username: 'RealWorld',
+      bio: 'My happy life',
+      image: null,
+      email: 'realworld@me.com',
+      password: 'secret',
+      followedBy: [{ id: 456 }],
+    };
+
+    // When
+    const result = authorMapper(author, 123);
+
+    // Then
+    expect(Object.keys(result).sort()).toEqual([
+      'bio',
+      'following',
+      'image',
+      'username',
+    ]);
+  });
+});
+

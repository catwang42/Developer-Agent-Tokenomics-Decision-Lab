+@pytest.mark.filterwarnings("ignore::zarr.core.dtype.common.UnstableSpecificationWarning")
+@given(data=st.data())
+def test_block_indexing_read(data: st.DataObject) -> None:
+    zarray = data.draw(
+        st.one_of(
+            simple_arrays(shapes=npst.array_shapes(max_dims=4, min_side=1)),
+            rectilinear_arrays(shapes=npst.array_shapes(max_dims=3, min_side=1, max_side=20)),
+        )
+    )
+    nparray = zarray[:]
+    chunk_counts = tuple(g.nchunks for g in zarray._chunk_grid._dimensions)
+    indexer = data.draw(block_selections(shape=nparray.shape, chunk_counts=chunk_counts))
+    np_indexer = block_selection_to_numpy_index(indexer, zarray)
+
+    expected = nparray[np_indexer]
+
+    # sync get dedicated method
+    actual_method = zarray.get_block_selection(indexer)
+    assert_array_equal(expected, actual_method)
+
+    # sync get indexer property
+    actual_blocks = zarray.blocks[indexer]
+    assert_array_equal(expected, actual_blocks)
+
+
+@pytest.mark.filterwarnings("ignore::zarr.core.dtype.common.UnstableSpecificationWarning")
+@given(data=st.data())
+def test_block_indexing_write(data: st.DataObject) -> None:
+    zarray = data.draw(
+        st.one_of(
+            simple_arrays(shapes=npst.array_shapes(max_dims=4, min_side=1)),
+            rectilinear_arrays(shapes=npst.array_shapes(max_dims=3, min_side=1, max_side=20)),
+        )
+    )
+    nparray = zarray[:]
+    chunk_counts = tuple(g.nchunks for g in zarray._chunk_grid._dimensions)
+    indexer = data.draw(block_selections(shape=nparray.shape, chunk_counts=chunk_counts))
+    np_indexer = block_selection_to_numpy_index(indexer, zarray)
+
+    target_slice = nparray[np_indexer]
+    new_data = data.draw(numpy_arrays(shapes=st.just(target_slice.shape), dtype=nparray.dtype))
+
+    # sync set dedicated method
+    nparray_copy = nparray.copy()
+    nparray_copy[np_indexer] = new_data
+    zarray.set_block_selection(indexer, new_data)
+    assert_array_equal(nparray_copy, zarray[:])
+
+    # sync set indexer property
+    zarray[:] = nparray
+    nparray_copy = nparray.copy()
+    nparray_copy[np_indexer] = new_data
+    zarray.blocks[indexer] = new_data
+    assert_array_equal(nparray_copy, zarray[:])
+

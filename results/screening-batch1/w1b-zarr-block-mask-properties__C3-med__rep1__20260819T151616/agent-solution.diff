+def block_selection_to_numpy_index(selection: Any, zarray: zarr.Array) -> tuple[slice, ...]:
+    """Convert a valid Zarr block selection into the equivalent NumPy index."""
+    dim_grids = zarray._chunk_grid._dimensions
+    norm_sel = replace_ellipsis(selection, zarray.shape)
+    np_index: list[slice] = []
+    for dim_sel, dim_len, dim_grid in zip(norm_sel, zarray.shape, dim_grids, strict=True):
+        nchunks = dim_grid.nchunks
+        if is_integer(dim_sel):
+            k = nchunks + dim_sel if dim_sel < 0 else dim_sel
+            start = dim_grid.chunk_offset(k)
+            stop = start + dim_grid.chunk_size(k)
+            np_index.append(slice(start, stop))
+        elif is_slice(dim_sel):
+            start = 0 if dim_sel.start is None else dim_sel.start
+            stop = nchunks if dim_sel.stop is None else dim_sel.stop
+            if start < 0:
+                start = nchunks + start
+            if stop < 0:
+                stop = nchunks + stop
+            start_off = dim_grid.chunk_offset(start) if start < nchunks else dim_len
+            stop_off = dim_grid.chunk_offset(stop) if stop < nchunks else dim_len
+            np_index.append(slice(start_off, stop_off))
+        else:
+            raise TypeError(f"Unexpected dimension selection item: {dim_sel!r}")
+    return tuple(np_index)
+

+@pytest.mark.asyncio
+@pytest.mark.filterwarnings("ignore::zarr.core.dtype.common.UnstableSpecificationWarning")
+@given(data=st.data())
+async def test_mask_indexing_read(data: st.DataObject) -> None:
+    zarray = data.draw(
+        st.one_of(
+            simple_arrays(shapes=npst.array_shapes(min_dims=1, max_dims=4, min_side=1)),
+            rectilinear_arrays(
+                shapes=npst.array_shapes(min_dims=1, max_dims=3, min_side=1, max_side=20)
+            ),
+        )
+    )
+    nparray = zarray[:]
+    mask = data.draw(npst.arrays(dtype=np.bool_, shape=nparray.shape))
+
+    expected = nparray[mask]
+
+    # sync get dedicated method
+    actual_method = zarray.get_mask_selection(mask)
+    assert_array_equal(expected, actual_method)
+
+    # sync get indexer property
+    actual_vindex = zarray.vindex[mask]
+    assert_array_equal(expected, actual_vindex)
+
+    # async get dedicated method
+    async_zarray = zarray._async_array
+    actual_async_method = await async_zarray.get_mask_selection(mask)
+    assert_array_equal(expected, actual_async_method)
+
+    # async get indexer property
+    actual_async_vindex = await async_zarray.vindex.getitem(mask)
+    assert_array_equal(expected, actual_async_vindex)
+

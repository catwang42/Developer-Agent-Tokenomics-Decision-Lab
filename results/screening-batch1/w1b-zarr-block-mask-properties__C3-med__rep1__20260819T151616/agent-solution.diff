+@st.composite
+def block_selections(
+    draw: st.DrawFn, *, shape: tuple[int, ...], chunk_counts: tuple[int, ...]
+) -> Any:
+    """Generate valid block selections conforming to Zarr block indexing constraints.
+
+    Only integers and step-1 slices whose start references an existing chunk are supported.
+    """
+    ndim = len(shape)
+    if ndim == 0:
+        return draw(st.sampled_from([(), Ellipsis, (Ellipsis,)]))
+
+    dim_items = []
+    for nchunks in chunk_counts:
+        int_choice = st.integers(min_value=-nchunks, max_value=nchunks - 1)
+        start_choice = st.none() | st.integers(min_value=-nchunks, max_value=nchunks - 1)
+        stop_choice = st.none() | st.integers(min_value=-nchunks, max_value=nchunks + 2)
+        step_choice = st.sampled_from([None, 1])
+        slice_choice = st.builds(slice, start_choice, stop_choice, step_choice)
+        dim_items.append(draw(int_choice | slice_choice))
+
+    format_mode = draw(st.sampled_from(["full", "single_if_1d", "truncated", "with_ellipsis"]))
+    if format_mode == "single_if_1d" and ndim == 1:
+        return dim_items[0]
+    elif format_mode == "truncated" and ndim > 1:
+        k = draw(st.integers(min_value=1, max_value=ndim - 1))
+        return tuple(dim_items[:k])
+    elif format_mode == "with_ellipsis":
+        k = draw(st.integers(min_value=0, max_value=ndim))
+        res = list(dim_items)
+        res.insert(k, Ellipsis)
+        return tuple(res)
+    else:
+        return tuple(dim_items)
+

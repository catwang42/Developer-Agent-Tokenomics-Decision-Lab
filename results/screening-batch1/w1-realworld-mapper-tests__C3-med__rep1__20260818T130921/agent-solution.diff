+import articleMapper from '../../app/routes/article/article.mapper';
+import authorMapper from '../../app/routes/article/author.mapper';
+
+describe('Mappers', () => {
+  describe('authorMapper', () => {
+    test('should return author with following=false when id is not provided', () => {
+      // Given
+      const author = {
+        username: 'john_doe',
+        bio: 'Software engineer and writer',
+        image: 'https://example.com/avatar.jpg',
+        followedBy: [{ id: 1 }, { id: 2 }],
+      };
+
+      // When
+      const result = authorMapper(author);
+
+      // Then
+      expect(result).toEqual({
+        username: 'john_doe',
+        bio: 'Software engineer and writer',
+        image: 'https://example.com/avatar.jpg',
+        following: false,
+      });
+    });
+
+    test('should return author with following=true when user id is in followedBy', () => {
+      // Given
+      const author = {
+        username: 'jane_doe',
+        bio: 'Tech enthusiast',
+        image: 'https://example.com/jane.jpg',
+        followedBy: [{ id: 10 }, { id: 20 }, { id: 30 }],
+      };
+      const currentUserId = 20;
+
+      // When
+      const result = authorMapper(author, currentUserId);
+
+      // Then
+      expect(result).toEqual({
+        username: 'jane_doe',
+        bio: 'Tech enthusiast',
+        image: 'https://example.com/jane.jpg',
+        following: true,
+      });
+    });
+
+    test('should return author with following=false when user id is not in followedBy', () => {
+      // Given
+      const author = {
+        username: 'jane_doe',
+        bio: null,
+        image: null,
+        followedBy: [{ id: 10 }, { id: 30 }],
+      };
+      const currentUserId = 999;
+
+      // When
+      const result = authorMapper(author, currentUserId);
+
+      // Then
+      expect(result).toEqual({
+        username: 'jane_doe',
+        bio: null,
+        image: null,
+        following: false,
+      });
+    });

+      const author = {
+        username: 'charlie',
+        bio: 'Engineer',
+        image: 'https://example.com/charlie.jpg',
+        followedBy: [{ id: 5 }],
+      };
+
+      // When
+      const result = authorMapper(author, undefined);
+
+      // Then
+      expect(result.following).toBe(false);
+    });
+  });
+
+  describe('complete author mapping', () => {
+    test('should map author with following true', () => {
+      // Given
+      const userId = 7;
+      const author = {
+        username: 'reactmaster',
+        bio: 'React enthusiast and open source contributor',
+        image: 'https://api.realworld.io/images/reactmaster.jpg',
+        followedBy: [
+          { id: 1 },
+          { id: 7 },
+          { id: 15 },
+        ],
+      };
+
+      // When
+      const result = authorMapper(author, userId);
+
+      // Then
+      expect(result).toEqual({
+        username: 'reactmaster',
+        bio: 'React enthusiast and open source contributor',
+        image: 'https://api.realworld.io/images/reactmaster.jpg',
+        following: true,
+      });
+    });
+
+    test('should map author with following false', () => {
+      // Given
+      const userId = 99;
+      const author = {
+        username: 'pythondeveloper',
+        bio: 'Python and Django expert',
+        image: 'https://api.realworld.io/images/pythondeveloper.jpg',
+        followedBy: [
+          { id: 1 },
+          { id: 7 },
+          { id: 15 },
+        ],
+      };
+
+      // When
+      const result = authorMapper(author, userId);
+
+      // Then
+      expect(result).toEqual({
+        username: 'pythondeveloper',
+        bio: 'Python and Django expert',
+        image: 'https://api.realworld.io/images/pythondeveloper.jpg',
+        following: false,
+      });
+    });
+
+    test('should map author without id parameter', () => {
+      // Given
+      const author = {
+        username: 'nodedeveloper',
+        bio: 'Node.js and Express specialist',
+        image: 'https://api.realworld.io/images/nodedeveloper.jpg',
+        followedBy: [{ id: 5 }],
+      };
+
+      // When
+      const result = authorMapper(author);
+
+      // Then
+      expect(result).toEqual({
+        username: 'nodedeveloper',
+        bio: 'Node.js and Express specialist',
+        image: 'https://api.realworld.io/images/nodedeveloper.jpg',
+        following: false,
+      });
+    });
+  });
+
+  describe('edge cases', () => {
+    test('should handle author with null bio', () => {
+      // Given
+      const author = {
+        username: 'newuser',
+        bio: null,
+        image: null,
+        followedBy: [],
+      };
+
+      // When
+      const result = authorMapper(author, 1);
+
+      // Then
+      expect(result.username).toBe('newuser');
+      expect(result.bio).toBeNull();
+      expect(result.image).toBeNull();
+      expect(result.following).toBe(false);
+    });
+
+    test('should handle author with many followers', () => {
+      // Given
+      const followerCount = 1000;
+      const followedByArray = Array.from({ length: followerCount }, (_, i) => ({ id: i + 1 }));
+      const author = {
+        username: 'popular',
+        bio: 'Very popular author',
+        image: 'https://example.com/popular.jpg',
+        followedBy: followedByArray,
+      };
+
+      // When
+      const result = authorMapper(author, 500);
+
+      // Then
+      expect(result.following).toBe(true);
+    });
+
+    test('should handle author id that matches one in a large followedBy array', () => {
+      // Given
+      const followerCount = 100;
+      const followedByArray = Array.from({ length: followerCount }, (_, i) => ({ id: i + 1 }));
+      const author = {
+        username: 'influencer',
+        bio: 'Influencer',
+        image: 'https://example.com/influencer.jpg',
+        followedBy: followedByArray,
+      };
+
+      // When
+      const result = authorMapper(author, 1);
+
+      // Then
+      expect(result.following).toBe(true);
+    });
+  });
+});

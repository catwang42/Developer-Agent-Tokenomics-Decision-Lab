+import authorMapper from '../../app/routes/article/author.mapper';
+
+describe('authorMapper', () => {
+  describe('basic fields mapping', () => {
+    test('should map all author fields correctly', () => {
+      // Given
+      const author = {
+        username: 'jake',
+        bio: 'I work at statefarm',
+        image: 'https://api.realworld.io/images/jake.jpg',
+        followedBy: [],
+      };
+
+      // When
+      const result = authorMapper(author);
+
+      // Then
+      expect(result).toHaveProperty('username', 'jake');
+      expect(result).toHaveProperty('bio', 'I work at statefarm');
+      expect(result).toHaveProperty('image', 'https://api.realworld.io/images/jake.jpg');
+      expect(result).toHaveProperty('following');
+    });
+  });
+
+  describe('following field when id is present', () => {
+    test('should set following to true when user id is in followedBy array', () => {
+      // Given
+      const author = {
+        username: 'jake',
+        bio: 'I work at statefarm',
+        image: 'https://api.realworld.io/images/jake.jpg',
+        followedBy: [
+          { id: 1 },
+          { id: 42 },
+          { id: 99 },
+        ],
+      };
+      const userId = 42;
+
+      // When
+      const result = authorMapper(author, userId);
+
+      // Then
+      expect(result.following).toBe(true);
+      expect(result).toEqual({
+        username: 'jake',
+        bio: 'I work at statefarm',
+        image: 'https://api.realworld.io/images/jake.jpg',
+        following: true,
+      });
+    });
+
+    test('should set following to false when user id is not in followedBy array', () => {
+      // Given
+      const author = {
+        username: 'jake',
+        bio: 'I work at statefarm',
+        image: 'https://api.realworld.io/images/jake.jpg',
+        followedBy: [
+          { id: 1 },
+          { id: 2 },
+          { id: 3 },
+        ],
+      };
+      const userId = 99;
+
+      // When
+      const result = authorMapper(author, userId);
+
+      // Then
+      expect(result.following).toBe(false);
+      expect(result).toEqual({
+        username: 'jake',
+        bio: 'I work at statefarm',
+        image: 'https://api.realworld.io/images/jake.jpg',
+        following: false,
+      });
+    });
+
+    test('should set following to false when followedBy array is empty and id is provided', () => {
+      // Given
+      const author = {
+        username: 'jake',
+        bio: 'I work at statefarm',
+        image: 'https://api.realworld.io/images/jake.jpg',
+        followedBy: [],
+      };
+      const userId = 123;
+
+      // When
+      const result = authorMapper(author, userId);
+
+      // Then
+      expect(result.following).toBe(false);
+    });
+
+    test('should set following to true when searching for first user in followedBy', () => {
+      // Given
+      const author = {
+        username: 'alice',
+        bio: 'Developer',
+        image: 'https://example.com/alice.jpg',
+        followedBy: [
+          { id: 10 },
+          { id: 20 },
+          { id: 30 },
+        ],
+      };
+
+      // When
+      const result = authorMapper(author, 10);
+
+      // Then
+      expect(result.following).toBe(true);
+    });
+
+    test('should set following to true when searching for last user in followedBy', () => {
+      // Given
+      const author = {
+        username: 'bob',
+        bio: 'Designer',
+        image: 'https://example.com/bob.jpg',
+        followedBy: [
+          { id: 10 },
+          { id: 20 },
+          { id: 30 },
+        ],
+      };
+
+      // When
+      const result = authorMapper(author, 30);
+
+      // Then
+      expect(result.following).toBe(true);
+    });
+  });
+
+  describe('following field when id is absent', () => {
+    test('should set following to false when no id is provided', () => {
+      // Given
+      const author = {
+        username: 'jake',
+        bio: 'I work at statefarm',
+        image: 'https://api.realworld.io/images/jake.jpg',
+        followedBy: [
+          { id: 1 },
+          { id: 2 },
+          { id: 3 },
+        ],
+      };
+
+      // When
+      const result = authorMapper(author);
+
+      // Then
+      expect(result.following).toBe(false);
+      expect(result).toEqual({
+        username: 'jake',
+        bio: 'I work at statefarm',
+        image: 'https://api.realworld.io/images/jake.jpg',
+        following: false,
+      });
+    });
+
+    test('should set following to false when id is undefined', () => {

+import authorMapper from '../../app/routes/article/author.mapper';
+import articleMapper from '../../app/routes/article/article.mapper';
+
+const baseAuthor = {
+  username: 'jane',
+  bio: 'A writer',
+  image: 'https://example.com/jane.png',
+  followedBy: [{ id: 1 }, { id: 2 }],
+};
+
+describe('authorMapper', () => {
+  describe('when id is absent', () => {
+    it('returns following: false', () => {
+      const result = authorMapper(baseAuthor);
+      expect(result).toEqual({
+        username: 'jane',
+        bio: 'A writer',
+        image: 'https://example.com/jane.png',
+        following: false,
+      });
+    });
+  });
+
+  describe('when id is present and user IS in followedBy', () => {
+    it('returns following: true', () => {
+      const result = authorMapper(baseAuthor, 1);
+      expect(result).toEqual({
+        username: 'jane',
+        bio: 'A writer',
+        image: 'https://example.com/jane.png',
+        following: true,
+      });
+    });
+  });
+
+  describe('when id is present but user is NOT in followedBy', () => {
+    it('returns following: false', () => {
+      const result = authorMapper(baseAuthor, 99);
+      expect(result).toEqual({
+        username: 'jane',
+        bio: 'A writer',
+        image: 'https://example.com/jane.png',
+        following: false,
+      });
+    });
+  });
+});
+
+const baseArticle = {
+  slug: 'test-article',
+  title: 'Test Article',
+  description: 'A test description',
+  body: 'Article body text',
+  tagList: [],
+  createdAt: new Date('2024-01-01T00:00:00.000Z'),
+  updatedAt: new Date('2024-01-02T00:00:00.000Z'),
+  favoritedBy: [{ id: 10 }, { id: 20 }],
+  author: { ...baseAuthor },
+};
+
+describe('articleMapper', () => {
+  describe('favorited', () => {
+    it('is true when the requesting id is in favoritedBy', () => {
+      const result = articleMapper(baseArticle, 10);
+      expect(result.favorited).toBe(true);
+    });
+
+    it('is false when the requesting id is not in favoritedBy', () => {
+      const result = articleMapper(baseArticle, 99);
+      expect(result.favorited).toBe(false);
+    });
+
+    it('is false when no id is provided', () => {
+      const result = articleMapper(baseArticle);
+      expect(result.favorited).toBe(false);
+    });
+  });
+
+  describe('favoritesCount', () => {
+    it('reflects the length of favoritedBy', () => {
+      const result = articleMapper(baseArticle, 10);
+      expect(result.favoritesCount).toBe(2);
+    });
+
+    it('is 0 when favoritedBy is empty', () => {
+      const article = { ...baseArticle, favoritedBy: [] };
+      const result = articleMapper(article);
+      expect(result.favoritesCount).toBe(0);
+    });
+  });
+
+  describe('tagList', () => {
+    it('maps an empty tagList to an empty array', () => {
+      const result = articleMapper(baseArticle);
+      expect(result.tagList).toEqual([]);
+    });
+
+    it('maps tag objects to their name strings', () => {
+      const article = {
+        ...baseArticle,
+        tagList: [{ name: 'react' }, { name: 'typescript' }],
+      };
+      const result = articleMapper(article);
+      expect(result.tagList).toEqual(['react', 'typescript']);
+    });
+  });
+
+  describe('full shape', () => {
+    it('returns the complete mapped object', () => {
+      const article = {
+        ...baseArticle,
+        tagList: [{ name: 'node' }],
+        favoritedBy: [{ id: 5 }],
+        author: { ...baseAuthor, followedBy: [{ id: 5 }] },
+      };
+      const result = articleMapper(article, 5);
+      expect(result).toEqual({
+        slug: 'test-article',
+        title: 'Test Article',
+        description: 'A test description',
+        body: 'Article body text',
+        tagList: ['node'],
+        createdAt: article.createdAt,
+        updatedAt: article.updatedAt,
+        favorited: true,
+        favoritesCount: 1,
+        author: {
+          username: 'jane',
+          bio: 'A writer',
+          image: 'https://example.com/jane.png',
+          following: true,
+        },
+      });
+    });
+  });
+});

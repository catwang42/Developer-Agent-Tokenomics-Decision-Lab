+import authorMapper from '../../app/routes/article/author.mapper';
+import articleMapper from '../../app/routes/article/article.mapper';
+
+const baseAuthor = {
+  username: 'jane',
+  bio: 'writes things',
+  image: 'https://example.com/jane.jpg',
+  followedBy: [],
+};
+
+describe('authorMapper', () => {
+  test('returns false for following when no id provided', () => {
+    const result = authorMapper(baseAuthor);
+    expect(result).toEqual({
+      username: 'jane',
+      bio: 'writes things',
+      image: 'https://example.com/jane.jpg',
+      following: false,
+    });
+  });
+
+  test('returns false for following when id is provided but user is not in followedBy', () => {
+    const author = { ...baseAuthor, followedBy: [{ id: 99 }] };
+    const result = authorMapper(author, 42);
+    expect(result).toEqual({
+      username: 'jane',
+      bio: 'writes things',
+      image: 'https://example.com/jane.jpg',
+      following: false,
+    });
+  });
+
+  test('returns true for following when id is present in followedBy', () => {
+    const author = { ...baseAuthor, followedBy: [{ id: 42 }, { id: 7 }] };
+    const result = authorMapper(author, 42);
+    expect(result).toEqual({
+      username: 'jane',
+      bio: 'writes things',
+      image: 'https://example.com/jane.jpg',
+      following: true,
+    });
+  });
+});
+
+describe('articleMapper', () => {
+  const baseArticle = {
+    slug: 'test-article',
+    title: 'Test Article',
+    description: 'A description',
+    body: 'Body text',
+    tagList: [],
+    createdAt: new Date('2024-01-01T00:00:00Z'),
+    updatedAt: new Date('2024-01-02T00:00:00Z'),
+    favoritedBy: [],
+    author: baseAuthor,
+  };
+
+  test('favorited is false when requesting id is not in favoritedBy', () => {
+    const result = articleMapper(baseArticle, 5);
+    expect(result.favorited).toBe(false);
+  });
+
+  test('favorited is true when requesting id is in favoritedBy', () => {
+    const article = { ...baseArticle, favoritedBy: [{ id: 5 }, { id: 9 }] };
+    const result = articleMapper(article, 5);
+    expect(result.favorited).toBe(true);
+  });
+
+  test('favoritesCount reflects length of favoritedBy', () => {
+    const article = { ...baseArticle, favoritedBy: [{ id: 1 }, { id: 2 }, { id: 3 }] };
+    const result = articleMapper(article, 99);
+    expect(result.favoritesCount).toBe(3);
+  });
+
+  test('tagList is empty array when article has no tags', () => {
+    const result = articleMapper(baseArticle, 1);
+    expect(result.tagList).toEqual([]);
+  });
+
+  test('tagList maps tag objects to their name strings', () => {
+    const article = {
+      ...baseArticle,
+      tagList: [{ name: 'react' }, { name: 'typescript' }],
+    };
+    const result = articleMapper(article, 1);
+    expect(result.tagList).toEqual(['react', 'typescript']);
+  });
+
+  test('maps all scalar fields correctly', () => {
+    const result = articleMapper(baseArticle, 1);
+    expect(result.slug).toBe('test-article');
+    expect(result.title).toBe('Test Article');
+    expect(result.description).toBe('A description');
+    expect(result.body).toBe('Body text');
+    expect(result.createdAt).toEqual(new Date('2024-01-01T00:00:00Z'));
+    expect(result.updatedAt).toEqual(new Date('2024-01-02T00:00:00Z'));
+  });
+
+  test('author field is produced by authorMapper with the same id', () => {
+    const article = {
+      ...baseArticle,
+      author: { ...baseAuthor, followedBy: [{ id: 42 }] },
+    };
+    const result = articleMapper(article, 42);
+    expect(result.author).toEqual({
+      username: 'jane',
+      bio: 'writes things',
+      image: 'https://example.com/jane.jpg',
+      following: true,
+    });
+  });
+});

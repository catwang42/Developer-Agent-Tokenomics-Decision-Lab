+import authorMapper from '../../app/routes/article/author.mapper';
+import { User } from '../../app/routes/auth/user.model';
+
+describe('AuthorMapper', () => {
+  describe('following with id present', () => {
+    test('should set following to true when user id is in followedBy', () => {
+      // Given
+      const author = {
+        username: 'jake',
+        bio: 'I work at statefarm',
+        image: 'https://i.stack.imgur.com/xHWG8.jpg',
+        followedBy: [
+          { id: 1 },
+          { id: 5 },
+          { id: 10 },
+        ] as Partial<User>[],
+      };
+      const userId = 5;
+
+      // When
+      const result = authorMapper(author, userId);
+
+      // Then
+      expect(result.following).toBe(true);
+    });
+
+    test('should set following to false when user id is not in followedBy', () => {
+      // Given
+      const author = {
+        username: 'jake',
+        bio: 'I work at statefarm',
+        image: 'https://i.stack.imgur.com/xHWG8.jpg',
+        followedBy: [
+          { id: 1 },
+          { id: 5 },
+        ] as Partial<User>[],
+      };
+      const userId = 99;
+
+      // When
+      const result = authorMapper(author, userId);
+
+      // Then
+      expect(result.following).toBe(false);
+    });
+
+    test('should set following to false when followedBy is empty but id is present', () => {
+      // Given
+      const author = {
+        username: 'jake',
+        bio: 'I work at statefarm',
+        image: 'https://i.stack.imgur.com/xHWG8.jpg',
+        followedBy: [] as Partial<User>[],
+      };
+      const userId = 5;
+
+      // When
+      const result = authorMapper(author, userId);
+
+      // Then
+      expect(result.following).toBe(false);
+    });
+  });
+
+  describe('following with id absent', () => {
+    test('should set following to false when id is undefined', () => {
+      // Given
+      const author = {
+        username: 'jake',
+        bio: 'I work at statefarm',
+        image: 'https://i.stack.imgur.com/xHWG8.jpg',
+        followedBy: [
+          { id: 1 },
+          { id: 5 },
+        ] as Partial<User>[],
+      };
+
+      // When
+      const result = authorMapper(author, undefined);
+
+      // Then
+      expect(result.following).toBe(false);
+    });
+
+    test('should set following to false when id is null', () => {
+      // Given
+      const author = {
+        username: 'jake',
+        bio: 'I work at statefarm',
+        image: 'https://i.stack.imgur.com/xHWG8.jpg',
+        followedBy: [
+          { id: 1 },
+          { id: 5 },
+        ] as Partial<User>[],
+      };
+
+      // When
+      const result = authorMapper(author, null as any);
+
+      // Then
+      expect(result.following).toBe(false);
+    });
+
+    test('should set following to false when id is 0', () => {
+      // Given
+      const author = {
+        username: 'jake',
+        bio: 'I work at statefarm',
+        image: 'https://i.stack.imgur.com/xHWG8.jpg',
+        followedBy: [
+          { id: 1 },
+          { id: 5 },
+        ] as Partial<User>[],
+      };
+      const userId = 0;
+
+      // When
+      const result = authorMapper(author, userId);
+
+      // Then
+      expect(result.following).toBe(false);
+    });
+  });
+
+  describe('basic author fields', () => {
+    test('should map username correctly', () => {
+      // Given
+      const author = {
+        username: 'jake',
+        bio: 'I work at statefarm',
+        image: 'https://i.stack.imgur.com/xHWG8.jpg',
+        followedBy: [] as Partial<User>[],
+      };
+
+      // When
+      const result = authorMapper(author, 1);
+
+      // Then
+      expect(result.username).toBe('jake');
+    });
+
+    test('should map bio correctly', () => {
+      // Given
+      const author = {
+        username: 'jake',
+        bio: 'I work at statefarm',
+        image: 'https://i.stack.imgur.com/xHWG8.jpg',
+        followedBy: [] as Partial<User>[],
+      };
+
+      // When
+      const result = authorMapper(author, 1);
+
+      // Then
+      expect(result.bio).toBe('I work at statefarm');
+    });
+
+    test('should map bio when null', () => {
+      // Given
+      const author = {
+        username: 'jake',
+        bio: null,
+        image: 'https://i.stack.imgur.com/xHWG8.jpg',
+        followedBy: [] as Partial<User>[],
+      };
+
+      // When
+      const result = authorMapper(author, 1);
+
+      // Then
+      expect(result.bio).toBeNull();
+    });
+
+    test('should map image correctly', () => {
+      // Given
+      const author = {
+        username: 'jake',
+        bio: 'I work at statefarm',
+        image: 'https://i.stack.imgur.com/xHWG8.jpg',
+        followedBy: [] as Partial<User>[],
+      };
+
+      // When
+      const result = authorMapper(author, 1);
+
+      // Then
+      expect(result.image).toBe('https://i.stack.imgur.com/xHWG8.jpg');
+    });
+
+    test('should map image when null', () => {
+      // Given
+      const author = {
+        username: 'jake',
+        bio: 'I work at statefarm',
+        image: null,
+        followedBy: [] as Partial<User>[],
+      };
+
+      // When
+      const result = authorMapper(author, 1);
+
+      // Then
+      expect(result.image).toBeNull();
+    });
+  });
+
+  describe('complete author mapping', () => {
+    test('should map complete author object', () => {
+      // Given
+      const author = {
+        username: 'jake',
+        bio: 'I work at statefarm',
+        image: 'https://i.stack.imgur.com/xHWG8.jpg',
+        followedBy: [{ id: 10 }] as Partial<User>[],
+      };
+      const userId = 10;
+
+      // When
+      const result = authorMapper(author, userId);
+
+      // Then
+      expect(result).toEqual({
+        username: 'jake',
+        bio: 'I work at statefarm',
+        image: 'https://i.stack.imgur.com/xHWG8.jpg',
+        following: true,
+      });
+    });
+
+    test('should have exactly 4 properties in result', () => {
+      // Given
+      const author = {
+        username: 'jake',
+        bio: 'I work at statefarm',
+        image: 'https://i.stack.imgur.com/xHWG8.jpg',
+        followedBy: [] as Partial<User>[],
+      };
+
+      // When
+      const result = authorMapper(author, 1);
+
+      // Then
+      expect(Object.keys(result)).toHaveLength(4);
+      expect(result).toHaveProperty('username');
+      expect(result).toHaveProperty('bio');
+      expect(result).toHaveProperty('image');
+      expect(result).toHaveProperty('following');
+    });
+  });
+});

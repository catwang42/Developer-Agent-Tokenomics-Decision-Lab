+import articleMapper from '../../app/routes/article/article.mapper';
+import authorMapper from '../../app/routes/article/author.mapper';
+
+// Mock the author mapper
+jest.mock('../../app/routes/article/author.mapper');
+
+describe('ArticleMapper', () => {
+  beforeEach(() => {
+    jest.clearAllMocks();
+    // Mock the authorMapper to return a consistent shape
+    (authorMapper as jest.Mock).mockReturnValue({
+      username: 'testauthor',
+      bio: 'Test bio',
+      image: 'https://example.com/image.jpg',
+      following: false,
+    });
+  });
+
+  describe('tagList mapping', () => {
+    test('should map empty tagList', () => {
+      // Given
+      const article = {
+        slug: 'test-article',
+        title: 'Test Article',
+        description: 'Test description',
+        body: 'Test body',
+        tagList: [],
+        createdAt: '2023-01-01T00:00:00Z',
+        updatedAt: '2023-01-02T00:00:00Z',
+        favoritedBy: [],
+        author: { username: 'testauthor' },
+      };
+      const userId = 1;
+
+      // When
+      const result = articleMapper(article, userId);
+
+      // Then
+      expect(result.tagList).toEqual([]);
+    });
+
+    test('should map non-empty tagList', () => {
+      // Given
+      const article = {
+        slug: 'test-article',
+        title: 'Test Article',
+        description: 'Test description',
+        body: 'Test body',
+        tagList: [
+          { name: 'javascript' },
+          { name: 'testing' },
+          { name: 'jest' },
+        ],
+        createdAt: '2023-01-01T00:00:00Z',
+        updatedAt: '2023-01-02T00:00:00Z',
+        favoritedBy: [],
+        author: { username: 'testauthor' },
+      };
+      const userId = 1;
+
+      // When
+      const result = articleMapper(article, userId);
+
+      // Then
+      expect(result.tagList).toEqual(['javascript', 'testing', 'jest']);
+    });
+  });
+
+  describe('favorited mapping', () => {
+    test('should set favorited to true when requesting user is in favoritedBy', () => {
+      // Given
+      const article = {
+        slug: 'test-article',
+        title: 'Test Article',
+        description: 'Test description',
+        body: 'Test body',
+        tagList: [],
+        createdAt: '2023-01-01T00:00:00Z',
+        updatedAt: '2023-01-02T00:00:00Z',
+        favoritedBy: [{ id: 5 }, { id: 10 }],
+        author: { username: 'testauthor' },
+      };
+      const userId = 5;
+
+      // When
+      const result = articleMapper(article, userId);
+
+      // Then
+      expect(result.favorited).toBe(true);
+    });
+
+    test('should set favorited to false when requesting user is not in favoritedBy', () => {
+      // Given
+      const article = {
+        slug: 'test-article',
+        title: 'Test Article',
+        description: 'Test description',
+        body: 'Test body',
+        tagList: [],
+        createdAt: '2023-01-01T00:00:00Z',
+        updatedAt: '2023-01-02T00:00:00Z',
+        favoritedBy: [{ id: 5 }, { id: 10 }],
+        author: { username: 'testauthor' },
+      };
+      const userId = 99;
+
+      // When
+      const result = articleMapper(article, userId);
+
+      // Then
+      expect(result.favorited).toBe(false);
+    });
+
+    test('should set favorited to false when favoritedBy is empty', () => {
+      // Given
+      const article = {
+        slug: 'test-article',
+        title: 'Test Article',
+        description: 'Test description',
+        body: 'Test body',
+        tagList: [],
+        createdAt: '2023-01-01T00:00:00Z',
+        updatedAt: '2023-01-02T00:00:00Z',
+        favoritedBy: [],
+        author: { username: 'testauthor' },
+      };
+      const userId = 1;
+
+      // When
+      const result = articleMapper(article, userId);
+
+      // Then
+      expect(result.favorited).toBe(false);
+    });
+  });
+
+  describe('favoritesCount mapping', () => {
+    test('should return correct count for empty favoritedBy', () => {
+      // Given
+      const article = {
+        slug: 'test-article',
+        title: 'Test Article',
+        description: 'Test description',
+        body: 'Test body',
+        tagList: [],
+        createdAt: '2023-01-01T00:00:00Z',
+        updatedAt: '2023-01-02T00:00:00Z',
+        favoritedBy: [],
+        author: { username: 'testauthor' },
+      };
+      const userId = 1;
+
+      // When
+      const result = articleMapper(article, userId);
+
+      // Then
+      expect(result.favoritesCount).toBe(0);
+    });
+
+    test('should return correct count for non-empty favoritedBy', () => {
+      // Given
+      const article = {
+        slug: 'test-article',
+        title: 'Test Article',
+        description: 'Test description',
+        body: 'Test body',
+        tagList: [],
+        createdAt: '2023-01-01T00:00:00Z',
+        updatedAt: '2023-01-02T00:00:00Z',
+        favoritedBy: [{ id: 1 }, { id: 2 }, { id: 3 }],
+        author: { username: 'testauthor' },
+      };
+      const userId = 1;
+
+      // When
+      const result = articleMapper(article, userId);
+
+      // Then
+      expect(result.favoritesCount).toBe(3);
+    });
+  });
+
+  describe('complete article mapping', () => {
+    test('should map all fields correctly', () => {
+      // Given
+      const article = {
+        slug: 'how-to-train-your-dragon',
+        title: 'How to train your dragon',
+        description: 'Ever wonder how?',
+        body: 'It takes a Jacobian',
+        tagList: [{ name: 'dragons' }, { name: 'training' }],
+        createdAt: '2023-01-01T00:00:00Z',
+        updatedAt: '2023-01-02T00:00:00Z',
+        favoritedBy: [{ id: 1 }, { id: 2 }],
+        author: { username: 'jake', bio: 'I work at statefarm' },
+      };
+      const userId = 1;
+
+      // When
+      const result = articleMapper(article, userId);
+
+      // Then
+      expect(result).toMatchObject({
+        slug: 'how-to-train-your-dragon',
+        title: 'How to train your dragon',
+        description: 'Ever wonder how?',
+        body: 'It takes a Jacobian',
+        tagList: ['dragons', 'training'],
+        createdAt: '2023-01-01T00:00:00Z',
+        updatedAt: '2023-01-02T00:00:00Z',
+        favorited: true,
+        favoritesCount: 2,
+      });
+      expect(result.author).toBeDefined();
+      expect(authorMapper).toHaveBeenCalledWith(article.author, userId);
+    });
+
+    test('should call authorMapper with article author and user id', () => {
+      // Given
+      const authorData = { username: 'jake', bio: 'I work at statefarm' };
+      const article = {
+        slug: 'test-article',
+        title: 'Test Article',
+        description: 'Test description',
+        body: 'Test body',
+        tagList: [],
+        createdAt: '2023-01-01T00:00:00Z',
+        updatedAt: '2023-01-02T00:00:00Z',
+        favoritedBy: [],
+        author: authorData,
+      };
+      const userId = 42;
+
+      // When
+      articleMapper(article, userId);
+
+      // Then
+      expect(authorMapper).toHaveBeenCalledWith(authorData, userId);
+      expect(authorMapper).toHaveBeenCalledTimes(1);
+    });
+  });
+});

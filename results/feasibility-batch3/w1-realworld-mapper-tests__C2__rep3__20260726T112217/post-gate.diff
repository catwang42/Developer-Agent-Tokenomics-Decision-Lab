+import authorMapper from '../../app/routes/article/author.mapper';
+
+describe('AuthorMapper', () => {
+  describe('author mapping', () => {
+    test('should map basic author fields', () => {
+      // Given
+      const author = {
+        username: 'jake',
+        bio: 'I work at statefarm',
+        image: 'https://i.stack.imgur.com/xHWG8.jpg',
+        followedBy: [],
+      };
+
+      // When
+      const result = authorMapper(author);
+
+      // Then
+      expect(result.username).toBe('jake');
+      expect(result.bio).toBe('I work at statefarm');
+      expect(result.image).toBe('https://i.stack.imgur.com/xHWG8.jpg');
+    });
+
+    test('should set following to false when id is not provided', () => {
+      // Given
+      const author = {
+        username: 'jake',
+        bio: 'I work at statefarm',
+        image: 'https://i.stack.imgur.com/xHWG8.jpg',
+        followedBy: [{ id: 123 }],
+      };
+
+      // When
+      const result = authorMapper(author);
+
+      // Then
+      expect(result.following).toBe(false);
+    });
+
+    test('should set following to false when id is provided but not in followedBy', () => {
+      // Given
+      const author = {
+        username: 'jake',
+        bio: 'I work at statefarm',
+        image: 'https://i.stack.imgur.com/xHWG8.jpg',
+        followedBy: [{ id: 456 }, { id: 789 }],
+      };
+      const requestingId = 123;
+
+      // When
+      const result = authorMapper(author, requestingId);
+
+      // Then
+      expect(result.following).toBe(false);
+    });
+
+    test('should set following to true when id is provided and is in followedBy', () => {
+      // Given
+      const author = {
+        username: 'jake',
+        bio: 'I work at statefarm',
+        image: 'https://i.stack.imgur.com/xHWG8.jpg',
+        followedBy: [{ id: 123 }, { id: 456 }],
+      };
+      const requestingId = 123;
+
+      // When
+      const result = authorMapper(author, requestingId);
+
+      // Then
+      expect(result.following).toBe(true);
+    });
+
+    test('should return complete mapped author object when not following', () => {
+      // Given
+      const author = {
+        username: 'jake',
+        bio: 'I work at statefarm',
+        image: 'https://i.stack.imgur.com/xHWG8.jpg',
+        followedBy: [{ id: 456 }],
+      };
+      const requestingId = 123;
+
+      // When
+      const result = authorMapper(author, requestingId);
+
+      // Then
+      expect(result).toEqual({
+        username: 'jake',
+        bio: 'I work at statefarm',
+        image: 'https://i.stack.imgur.com/xHWG8.jpg',
+        following: false,
+      });
+    });
+
+    test('should return complete mapped author object when following', () => {
+      // Given
+      const author = {
+        username: 'jake',
+        bio: 'I work at statefarm',
+        image: 'https://i.stack.imgur.com/xHWG8.jpg',
+        followedBy: [{ id: 123 }],
+      };
+      const requestingId = 123;
+
+      // When
+      const result = authorMapper(author, requestingId);
+
+      // Then
+      expect(result).toEqual({
+        username: 'jake',
+        bio: 'I work at statefarm',
+        image: 'https://i.stack.imgur.com/xHWG8.jpg',
+        following: true,
+      });
+    });
+
+    test('should handle author with empty followedBy when id is provided', () => {
+      // Given
+      const author = {
+        username: 'jake',
+        bio: 'I work at statefarm',
+        image: 'https://i.stack.imgur.com/xHWG8.jpg',
+        followedBy: [],
+      };
+      const requestingId = 123;
+
+      // When
+      const result = authorMapper(author, requestingId);
+
+      // Then
+      expect(result.following).toBe(false);
+    });
+
+    test('should match the correct user in followedBy with multiple entries', () => {
+      // Given
+      const author = {
+        username: 'jake',
+        bio: 'I work at statefarm',
+        image: 'https://i.stack.imgur.com/xHWG8.jpg',
+        followedBy: [{ id: 111 }, { id: 222 }, { id: 333 }, { id: 444 }],
+      };
+      const requestingId = 333;
+
+      // When
+      const result = authorMapper(author, requestingId);
+
+      // Then
+      expect(result.following).toBe(true);
+    });
+  });
+});

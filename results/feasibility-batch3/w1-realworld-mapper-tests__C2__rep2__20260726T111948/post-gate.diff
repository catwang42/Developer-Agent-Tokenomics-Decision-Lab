+import authorMapper from '../../app/routes/article/author.mapper';
+
+describe('AuthorMapper', () => {
+  describe('authorMapper', () => {
+    test('should set following to false when no user id provided', () => {
+      // Given
+      const author = {
+        username: 'testuser',
+        bio: 'Test bio',
+        image: 'https://example.com/image.jpg',
+        followedBy: [
+          { id: 100 },
+          { id: 200 },
+        ],
+      };
+
+      // When
+      const result = authorMapper(author);
+
+      // Then
+      expect(result).toEqual({
+        username: 'testuser',
+        bio: 'Test bio',
+        image: 'https://example.com/image.jpg',
+        following: false,
+      });
+      expect(result.following).toBe(false);
+    });
+
+    test('should set following to false when user id not in followedBy', () => {
+      // Given
+      const author = {
+        username: 'anotheruser',
+        bio: 'Another bio',
+        image: null,
+        followedBy: [
+          { id: 100 },
+          { id: 200 },
+        ],
+      };
+      const userId = 300;
+
+      // When
+      const result = authorMapper(author, userId);
+
+      // Then
+      expect(result).toEqual({
+        username: 'anotheruser',
+        bio: 'Another bio',
+        image: null,
+        following: false,
+      });
+      expect(result.following).toBe(false);
+    });
+
+    test('should set following to true when user id is in followedBy', () => {
+      // Given
+      const author = {
+        username: 'followeduser',
+        bio: 'Followed user bio',
+        image: 'https://example.com/followed.jpg',
+        followedBy: [
+          { id: 100 },
+          { id: 200 },
+          { id: 300 },
+        ],
+      };
+      const userId = 200;
+
+      // When
+      const result = authorMapper(author, userId);
+
+      // Then
+      expect(result).toEqual({
+        username: 'followeduser',
+        bio: 'Followed user bio',
+        image: 'https://example.com/followed.jpg',
+        following: true,
+      });
+      expect(result.following).toBe(true);
+    });
+
+    test('should set following to true when user id is the only follower', () => {
+      // Given
+      const author = {
+        username: 'singlefollower',
+        bio: 'Single follower user',
+        image: null,
+        followedBy: [
+          { id: 42 },
+        ],
+      };
+      const userId = 42;
+
+      // When
+      const result = authorMapper(author, userId);
+
+      // Then
+      expect(result.following).toBe(true);
+      expect(result.username).toBe('singlefollower');
+    });
+
+    test('should preserve all author fields exactly', () => {
+      // Given
+      const author = {
+        username: 'preservetest',
+        bio: 'Bio with special characters: !@#$%',
+        image: 'https://example.com/preserve.png',
+        followedBy: [],
+      };
+
+      // When
+      const result = authorMapper(author);
+
+      // Then
+      expect(result.username).toBe('preservetest');
+      expect(result.bio).toBe('Bio with special characters: !@#$%');
+      expect(result.image).toBe('https://example.com/preserve.png');
+    });
+
+    test('should handle empty followedBy array', () => {
+      // Given
+      const author = {
+        username: 'noFollowers',
+        bio: 'User with no followers',
+        image: null,
+        followedBy: [],
+      };
+      const userId = 999;
+
+      // When
+      const result = authorMapper(author, userId);
+
+      // Then
+      expect(result.following).toBe(false);
+    });
+
+    test('should handle null or undefined bio and image', () => {
+      // Given
+      const author = {
+        username: 'minimal_user',
+        bio: null,
+        image: undefined,
+        followedBy: [],
+      };
+
+      // When
+      const result = authorMapper(author);
+
+      // Then
+      expect(result.username).toBe('minimal_user');
+      expect(result.bio).toBeNull();
+      expect(result.image).toBeUndefined();
+      expect(result.following).toBe(false);
+    });
+
+    test('should correctly identify following status with multiple followers', () => {
+      // Given
+      const author = {
+        username: 'popularuser',
+        bio: 'Very popular',
+        image: 'https://example.com/popular.jpg',
+        followedBy: [
+          { id: 1 },
+          { id: 2 },
+          { id: 3 },
+          { id: 4 },
+          { id: 5 },
+          { id: 6 },
+          { id: 7 },
+          { id: 8 },
+        ],
+      };
+      const userId = 5;
+
+      // When
+      const result = authorMapper(author, userId);
+
+      // Then
+      expect(result.following).toBe(true);
+      expect(result.username).toBe('popularuser');
+    });
+
+    test('should return object with exactly four properties', () => {
+      // Given
+      const author = {
+        username: 'testuser',
+        bio: 'Test',
+        image: null,
+        followedBy: [],
+      };
+
+      // When
+      const result = authorMapper(author);
+
+      // Then
+      expect(Object.keys(result)).toHaveLength(4);
+      expect(result).toHaveProperty('username');
+      expect(result).toHaveProperty('bio');
+      expect(result).toHaveProperty('image');
+      expect(result).toHaveProperty('following');
+    });
+  });
+});

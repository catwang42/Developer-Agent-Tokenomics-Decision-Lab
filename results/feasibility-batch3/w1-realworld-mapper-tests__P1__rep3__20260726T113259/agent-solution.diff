+import authorMapper from '../../app/routes/article/author.mapper';
+
+describe('authorMapper', () => {
+  describe('basic author properties', () => {
+    test('should map basic author properties', () => {
+      // Given
+      const author = {
+        username: 'johndoe',
+        bio: 'A skilled writer',
+        image: 'https://example.com/author.jpg',
+        followedBy: [],
+      };
+
+      // When
+      const result = authorMapper(author);
+
+      // Then
+      expect(result).toEqual({
+        username: 'johndoe',
+        bio: 'A skilled writer',
+        image: 'https://example.com/author.jpg',
+        following: false,
+      });
+    });
+
+    test('should preserve null and empty string values', () => {
+      // Given
+      const author = {
+        username: 'janedoe',
+        bio: null,
+        image: '',
+        followedBy: [],
+      };
+
+      // When
+      const result = authorMapper(author);
+
+      // Then
+      expect(result).toEqual({
+        username: 'janedoe',
+        bio: null,
+        image: '',
+        following: false,
+      });
+    });
+  });
+
+  describe('following branch - id not present', () => {
+    test('should set following to false when id is undefined', () => {
+      // Given
+      const author = {
+        username: 'author1',
+        bio: 'Bio',
+        image: 'https://example.com/image.jpg',
+        followedBy: [
+          { id: 1 },
+          { id: 2 },
+          { id: 3 },
+        ],
+      };
+
+      // When
+      const result = authorMapper(author, undefined);
+
+      // Then
+      expect(result.following).toBe(false);
+    });
+
+    test('should set following to false when id is not provided', () => {
+      // Given
+      const author = {
+        username: 'author2',
+        bio: 'Another bio',
+        image: 'https://example.com/image2.jpg',
+        followedBy: [
+          { id: 5 },
+          { id: 10 },
+        ],
+      };
+
+      // When
+      const result = authorMapper(author);
+
+      // Then
+      expect(result.following).toBe(false);
+    });
+  });
+
+  describe('following branch - id present, user in followedBy', () => {
+    test('should set following to true when user id is in followedBy', () => {
+      // Given
+      const userId = 5;
+      const author = {
+        username: 'author3',
+        bio: 'Popular author',
+        image: 'https://example.com/popular.jpg',
+        followedBy: [
+          { id: 1 },
+          { id: 5 },
+          { id: 10 },
+        ],
+      };
+
+      // When
+      const result = authorMapper(author, userId);
+
+      // Then
+      expect(result.following).toBe(true);
+    });
+
+    test('should set following to true when user id is the only follower', () => {
+      // Given
+      const userId = 42;
+      const author = {
+        username: 'niche-author',
+        bio: 'Niche content creator',
+        image: 'https://example.com/niche.jpg',
+        followedBy: [
+          { id: 42 },
+        ],
+      };
+
+      // When
+      const result = authorMapper(author, userId);
+
+      // Then
+      expect(result.following).toBe(true);
+    });
+
+    test('should set following to true for first follower in list', () => {
+      // Given
+      const userId = 100;
+      const author = {
+        username: 'rising-author',
+        bio: 'Getting more followers',
+        image: 'https://example.com/rising.jpg',
+        followedBy: [
+          { id: 100 },
+          { id: 200 },
+          { id: 300 },
+        ],
+      };
+
+      // When
+      const result = authorMapper(author, userId);
+
+      // Then
+      expect(result.following).toBe(true);
+    });
+
+    test('should set following to true for last follower in list', () => {
+      // Given
+      const userId = 300;
+      const author = {
+        username: 'popular-author',
+        bio: 'Has many followers',
+        image: 'https://example.com/popular2.jpg',
+        followedBy: [
+          { id: 100 },
+          { id: 200 },
+          { id: 300 },
+        ],
+      };
+
+      // When
+      const result = authorMapper(author, userId);
+
+      // Then
+      expect(result.following).toBe(true);
+    });
+  });
+
+  describe('following branch - id present, user not in followedBy', () => {
+    test('should set following to false when user id is not in followedBy with empty followedBy', () => {
+      // Given
+      const userId = 123;
+      const author = {
+        username: 'unFollowed',
+        bio: 'No followers yet',
+        image: 'https://example.com/unfollowed.jpg',
+        followedBy: [],
+      };
+
+      // When
+      const result = authorMapper(author, userId);
+
+      // Then
+      expect(result.following).toBe(false);
+    });
+
+    test('should set following to false when user id is not in followedBy with other followers', () => {
+      // Given
+      const userId = 999;
+      const author = {
+        username: 'someAuthor',
+        bio: 'Has other followers',
+        image: 'https://example.com/someauthor.jpg',
+        followedBy: [
+          { id: 1 },
+          { id: 2 },
+          { id: 3 },
+        ],
+      };
+
+      // When
+      const result = authorMapper(author, userId);
+
+      // Then
+      expect(result.following).toBe(false);
+    });
+
+    test('should set following to false when user id does not match any followedBy id', () => {
+      // Given
+      const userId = 50;
+      const author = {
+        username: 'anotherAuthor',
+        bio: 'Different followers',
+        image: 'https://example.com/another.jpg',
+        followedBy: [
+          { id: 10 },
+          { id: 20 },
+          { id: 30 },
+          { id: 40 },
+        ],
+      };
+
+      // When
+      const result = authorMapper(author, userId);
+
+      // Then
+      expect(result.following).toBe(false);
+    });
+  });
+
+  describe('complete author object shape', () => {
+    test('should always return all required author properties', () => {
+      // Given
+      const author = {
+        username: 'testuser',
+        bio: 'Test bio',
+        image: 'https://example.com/test.jpg',
+        followedBy: [],
+      };
+
+      // When
+      const result = authorMapper(author, 123);
+
+      // Then
+      expect(result).toHaveProperty('username');
+      expect(result).toHaveProperty('bio');
+      expect(result).toHaveProperty('image');
+      expect(result).toHaveProperty('following');
+      expect(Object.keys(result)).toEqual(['username', 'bio', 'image', 'following']);
+    });
+  });
+
+  describe('edge cases', () => {
+    test('should handle author with long username and bio', () => {
+      // Given
+      const author = {
+        username: 'a'.repeat(100),
+        bio: 'b'.repeat(500),
+        image: 'https://example.com/long.jpg',
+        followedBy: [],
+      };
+
+      // When
+      const result = authorMapper(author);
+
+      // Then
+      expect(result.username).toBe('a'.repeat(100));
+      expect(result.bio).toBe('b'.repeat(500));
+      expect(result.following).toBe(false);
+    });
+
+    test('should handle large followedBy array', () => {
+      // Given
+      const userId = 50;
+      const largeFollowedBy = Array.from({ length: 1000 }, (_, i) => ({ id: i }));
+      const author = {
+        username: 'popularauthor',
+        bio: 'Very popular',
+        image: 'https://example.com/popular3.jpg',
+        followedBy: largeFollowedBy,
+      };
+
+      // When
+      const result = authorMapper(author, userId);
+
+      // Then
+      expect(result.following).toBe(true);
+    });
+
+    test('should treat numeric id of 0 as falsy and return false for following', () => {
+      // Given
+      const userId = 0;
+      const author = {
+        username: 'zerouser',
+        bio: 'Zero ID test',
+        image: 'https://example.com/zero.jpg',
+        followedBy: [
+          { id: 0 },
+          { id: 1 },
+        ],
+      };
+
+      // When
+      const result = authorMapper(author, userId);
+
+      // Then
+      expect(result.following).toBe(false);
+    });
+
+    test('should handle numeric id of 1', () => {
+      // Given
+      const userId = 1;
+      const author = {
+        username: 'oneuser',
+        bio: 'One ID test',
+        image: 'https://example.com/one.jpg',
+        followedBy: [
+          { id: 0 },
+          { id: 1 },
+          { id: 2 },
+        ],
+      };
+
+      // When
+      const result = authorMapper(author, userId);
+
+      // Then
+      expect(result.following).toBe(true);
+    });
+  });
+
+  describe('partial User objects in followedBy', () => {
+    test('should work with followedBy items that only have id property', () => {
+      // Given
+      const userId = 77;
+      const author = {
+        username: 'minimalAuthor',
+        bio: 'Test with minimal followedBy objects',
+        image: 'https://example.com/minimal.jpg',
+        followedBy: [
+          { id: 77 },
+          { id: 88 },
+        ],
+      };
+
+      // When
+      const result = authorMapper(author, userId);
+
+      // Then
+      expect(result.following).toBe(true);
+    });
+
+    test('should work with followedBy items that have extra properties', () => {
+      // Given
+      const userId = 55;
+      const author = {
+        username: 'fullAuthor',
+        bio: 'Test with full followedBy objects',
+        image: 'https://example.com/full.jpg',
+        followedBy: [
+          { id: 55, username: 'user1', bio: 'bio1', email: 'test@example.com' },
+          { id: 66, username: 'user2', bio: 'bio2', email: 'test2@example.com' },
+        ],
+      };
+
+      // When
+      const result = authorMapper(author, userId);
+
+      // Then
+      expect(result.following).toBe(true);
+    });
+  });
+});
